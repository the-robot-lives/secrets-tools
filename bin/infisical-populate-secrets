#!/usr/bin/env bash
# =============================================================================
# Infisical Secret Population Engine (config-driven)
#
# Reads a secrets.yaml config file defining the secret topology — folders,
# variable resolution rules, and Infisical path mappings — then populates
# Infisical via its REST API.
#
# Usage:
#   infisical-populate-secrets --env=prod [--dry-run] [--show-secrets]
#   infisical-populate-secrets --env=staging [--dry-run]
#   infisical-populate-secrets --config=path/to/secrets.yaml --env=prod
#
# Required environment variables:
#   K8_INFISICAL_HOST           — Infisical server URL
#   K8_INFISICAL_PROJECT_ID     — Infisical project UUID
#   K8_INFISICAL_CLIENT_ID      — Universal auth client ID
#   K8_INFISICAL_CLIENT_SECRET  — Universal auth client secret
#
# Dependencies: yq (v4+), curl, openssl, bash 4+
# =============================================================================
set -euo pipefail

# -----------------------------------------------------------------------------
# Flags
# -----------------------------------------------------------------------------
DRY_RUN=false
SHOW_SECRETS=false
ENV_ARG=""
CONFIG_ARG=""
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    --show-secrets) SHOW_SECRETS=true ;;
    --env=*) ENV_ARG="${arg#--env=}" ;;
    --config=*) CONFIG_ARG="${arg#--config=}" ;;
    --help|-h)
      echo "Usage: $(basename "$0") --env=<prod|staging> [--config=FILE] [--dry-run] [--show-secrets]"
      echo ""
      echo "  --env=ENV       Target environment: prod or staging (required)"
      echo "  --config=FILE   Path to secrets.yaml (default: ./secrets.yaml)"
      echo "  --dry-run       Show which secrets would be created/changed. No writes."
      echo "  --show-secrets  Include secret values in output (default: hidden)."
      echo ""
      echo "  Staging mode copies all secrets from prod into the staging environment."
      exit 0
      ;;
  esac
done

ENV_SLUG="${ENV_ARG:-${INFISICAL_ENV:-}}"
if [[ -z "$ENV_SLUG" ]]; then
  echo "❌  No environment specified."
  echo "    Usage: $(basename "$0") --env=prod  or  --env=staging"
  exit 1
fi

if [[ "$ENV_SLUG" != "prod" && "$ENV_SLUG" != "staging" ]]; then
  echo "❌  Unknown environment: $ENV_SLUG (expected: prod or staging)"
  exit 1
fi

if $DRY_RUN; then
  echo "🔍  DRY RUN — no secrets will be written"
  echo ""
fi

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
if ! command -v yq &>/dev/null; then
  echo "❌  yq (v4+) is required but not found."
  echo "    Install: brew install yq  or  go install github.com/mikefarah/yq/v4@latest"
  exit 1
fi

# -----------------------------------------------------------------------------
# Config file
# -----------------------------------------------------------------------------
CONFIG="${CONFIG_ARG:-secrets.yaml}"
if [[ ! -f "$CONFIG" ]]; then
  echo "❌  Config file not found: $CONFIG"
  echo "    Copy secrets.yaml.example to secrets.yaml and customize."
  exit 1
fi

# -----------------------------------------------------------------------------
# Infisical connection
# -----------------------------------------------------------------------------
INFISICAL_HOST="${INFISICAL_HOST:-${K8_INFISICAL_HOST:-}}"
PROJECT_ID="${INFISICAL_PROJECT_ID:-${K8_INFISICAL_PROJECT_ID:-}}"

if [[ -z "$INFISICAL_HOST" ]]; then
  echo "❌  K8_INFISICAL_HOST (or INFISICAL_HOST) is not set."
  exit 1
fi
if [[ -z "$PROJECT_ID" ]]; then
  echo "❌  K8_INFISICAL_PROJECT_ID (or INFISICAL_PROJECT_ID) is not set."
  exit 1
fi

# -----------------------------------------------------------------------------
# Auth — universal auth via API
# -----------------------------------------------------------------------------
EKS_OPERATOR_CLIENT_ID="${EKS_OPERATOR_CLIENT_ID:-${K8_INFISICAL_CLIENT_ID:-}}"
EKS_OPERATOR_CLIENT_SECRET="${EKS_OPERATOR_CLIENT_SECRET:-${K8_INFISICAL_CLIENT_SECRET:-}}"

if [[ -z "$EKS_OPERATOR_CLIENT_ID" ]]; then
  echo "❌  K8_INFISICAL_CLIENT_ID (or EKS_OPERATOR_CLIENT_ID) is not set."
  exit 1
fi
if [[ -z "$EKS_OPERATOR_CLIENT_SECRET" ]]; then
  echo "❌  K8_INFISICAL_CLIENT_SECRET (or EKS_OPERATOR_CLIENT_SECRET) is not set."
  exit 1
fi

echo "🔑  Logging in via universal auth ..."
LOGIN_RESPONSE=$(curl -s -X POST "${INFISICAL_HOST}/api/v1/auth/universal-auth/login" \
  -H "Content-Type: application/json" \
  -d "{\"clientId\":\"${EKS_OPERATOR_CLIENT_ID}\",\"clientSecret\":\"${EKS_OPERATOR_CLIENT_SECRET}\"}")
API_TOKEN=$(echo "$LOGIN_RESPONSE" | grep -o '"accessToken":"[^"]*"' | cut -d'"' -f4)

if [[ -z "$API_TOKEN" ]]; then
  echo "❌  Could not get API token. Check client credentials."
  exit 1
fi

PROJECT_NAME=$(yq '.project_name // "secrets"' "$CONFIG")
echo "✅  Authenticated with Infisical"
echo "    Host:    $INFISICAL_HOST"
echo "    Project: $PROJECT_ID ($PROJECT_NAME)"
echo "    Env:     $ENV_SLUG"
echo "    Config:  $CONFIG"
echo ""

# -----------------------------------------------------------------------------
# Read folders from config
# -----------------------------------------------------------------------------
mapfile -t SECRET_FOLDERS < <(yq '.folders[]' "$CONFIG")

# -----------------------------------------------------------------------------
# Ensure all secret folders exist
# -----------------------------------------------------------------------------
ensure_folder() {
  local folder="$1"
  local response
  response=$(curl -s -w "\n%{http_code}" \
    -X POST "${INFISICAL_HOST}/api/v2/folders" \
    -H "Authorization: Bearer ${API_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "{\"projectId\":\"${PROJECT_ID}\",\"environment\":\"${ENV_SLUG}\",\"name\":\"${folder}\",\"path\":\"/\"}" \
    || true)
  local http_code
  http_code=$(echo "$response" | tail -1)
  if [[ "$http_code" == "200" || "$http_code" == "201" ]]; then
    echo "  🆕  /${folder}"
  elif echo "$response" | grep -q "already exists"; then
    echo "  ▪️   /${folder}"
  else
    echo "  ❌  /${folder} (HTTP ${http_code})"
  fi
}

if $DRY_RUN; then
  echo "📂  Skipping folder creation (dry run)"
else
  echo "📂  Ensuring secret folders ..."
  batch=0
  for folder in "${SECRET_FOLDERS[@]}"; do
    ensure_folder "$folder" &
    batch=$((batch+1))
    if (( batch % 4 == 0 )); then
      wait
    fi
  done
  wait
fi
echo ""

# -----------------------------------------------------------------------------
# Generators
# -----------------------------------------------------------------------------
generate_password() {
  local name="${1:-_NOT_PROVIDED_}"
  local pw
  pw=$(openssl rand -base64 32 | tr -d '=+/' | cut -c1-32)
  if ! $DRY_RUN && $SHOW_SECRETS; then
    echo "export ${name}=${pw}" >> .envrc.secrets
  fi
  echo "$pw"
}

generate_hex() {
  openssl rand -hex 32
}

generate_django() {
  python3 -c "
import secrets, string
chars = string.ascii_letters + string.digits + '!@#\$%^&*(-_=+)'
print(''.join(secrets.choice(chars) for _ in range(50)))
" 2>/dev/null || generate_hex
}

# -----------------------------------------------------------------------------
# Infisical API helpers
# -----------------------------------------------------------------------------
get_secret() {
  local path="$1"
  local key="$2"
  local response
  response=$(curl -s \
    -X GET "${INFISICAL_HOST}/api/v3/secrets/raw/${key}?workspaceId=${PROJECT_ID}&environment=${ENV_SLUG}&secretPath=${path}" \
    -H "Authorization: Bearer ${API_TOKEN}")
  echo "$response" | grep -o '"secretValue":"[^"]*"' | cut -d'"' -f4 || true
}

set_secret() {
  local path="$1"
  local key="$2"
  local value="$3"

  if $DRY_RUN; then
    local current
    current=$(get_secret "$path" "$key")
    if [[ -z "$current" ]]; then
      echo "  🆕  ${path}/${key}"
    elif [[ "$current" == "$value" ]]; then
      echo "  ▪️   ${path}/${key}"
    else
      echo "  ✅  ${path}/${key}"
    fi
    return
  fi

  local current
  current=$(get_secret "$path" "$key")

  local http_code
  if [[ -z "$current" ]]; then
    http_code=$(curl -s -o /dev/null -w "%{http_code}" \
      -X POST "${INFISICAL_HOST}/api/v3/secrets/raw/${key}" \
      -H "Authorization: Bearer ${API_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "{\"workspaceId\":\"${PROJECT_ID}\",\"environment\":\"${ENV_SLUG}\",\"secretPath\":\"${path}\",\"secretValue\":\"${value}\",\"type\":\"shared\"}")
    if [[ "$http_code" == "200" || "$http_code" == "201" ]]; then
      echo "  🆕  ${path}/${key}"
    else
      echo "  ❌  ${path}/${key} (HTTP ${http_code})"
    fi
  elif [[ "$current" == "$value" ]]; then
    echo "  ▪️   ${path}/${key}"
  else
    http_code=$(curl -s -o /dev/null -w "%{http_code}" \
      -X PATCH "${INFISICAL_HOST}/api/v3/secrets/raw/${key}" \
      -H "Authorization: Bearer ${API_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "{\"workspaceId\":\"${PROJECT_ID}\",\"environment\":\"${ENV_SLUG}\",\"secretPath\":\"${path}\",\"secretValue\":\"${value}\",\"type\":\"shared\"}")
    if [[ "$http_code" == "200" ]]; then
      echo "  ✅  ${path}/${key}"
    else
      echo "  ❌  ${path}/${key} (HTTP ${http_code})"
    fi
  fi
}

# =============================================================================
# STAGING: copy all secrets from prod → staging, then exit
# =============================================================================
if [[ "$ENV_SLUG" == "staging" ]]; then
  echo "📋  Copying all secrets from prod → staging ..."
  echo ""

  list_prod_keys() {
    local path="$1"
    curl -s \
      -X GET "${INFISICAL_HOST}/api/v3/secrets/raw?workspaceId=${PROJECT_ID}&environment=prod&secretPath=${path}&recursive=false" \
      -H "Authorization: Bearer ${API_TOKEN}" \
    | grep -o '"secretKey":"[^"]*"' | cut -d'"' -f4
  }

  get_prod_secret() {
    local path="$1"
    local key="$2"
    local response
    response=$(curl -s \
      -X GET "${INFISICAL_HOST}/api/v3/secrets/raw/${key}?workspaceId=${PROJECT_ID}&environment=prod&secretPath=${path}" \
      -H "Authorization: Bearer ${API_TOKEN}")
    echo "$response" | grep -o '"secretValue":"[^"]*"' | cut -d'"' -f4 || true
  }

  copy_folder() {
    local folder="$1"
    local keys
    keys=$(list_prod_keys "/${folder}")

    if [[ -z "$keys" ]]; then
      echo "  ⚠️   /${folder} — no secrets in prod"
      return
    fi

    echo "  📁  /${folder}"
    while IFS= read -r key; do
      local val
      val=$(get_prod_secret "/${folder}" "$key")
      if [[ -n "$val" ]]; then
        set_secret "/${folder}" "$key" "$val"
      fi
    done <<< "$keys"
  }

  for folder in "${SECRET_FOLDERS[@]}"; do
    copy_folder "$folder"
  done

  echo ""
  echo "=============================================="
  echo "✅  Done! Copied prod secrets → staging"
  echo ""
  echo "  Verify with:"
  echo "    infisical secrets list --projectId $PROJECT_ID --env staging --path /${SECRET_FOLDERS[0]} --domain $INFISICAL_HOST"
  echo "=============================================="
  exit 0
fi

# =============================================================================
# PROD: Resolve all variables from config, then apply mappings
# =============================================================================

declare -A RESOLVED
SKIPPED=()

# -----------------------------------------------------------------------------
# Phase 1 — Preprocess config: normalize all variable specs via single yq call
# -----------------------------------------------------------------------------
# Output format: VAR_NAME<TAB>NORMALIZED_SPEC
# Shorthand strings pass through as-is. Expanded objects are normalized to
# a canonical string: "generate:TYPE", "env:NAME", "default:VALUE", "eval:EXPR",
# or combinations like "env:NAME generate:TYPE" / "env:NAME default:VALUE".
# -----------------------------------------------------------------------------
VARS_CACHE=$(yq '
  .variables | to_entries | .[] |
  .key + "\t" + (
    if (.value | type) == "!!str" then .value
    elif (.value | type) == "!!map" then (
      [
        (if .value.env then "env:" + .value.env else "" end),
        (if .value.generate then "generate:" + .value.generate else "" end),
        (if .value.inherit then "inherit:" + .value.inherit else "" end),
        (if .value.eval then "eval:" + .value.eval else "" end),
        (if .value.default then "default:" + (.value.default | tostring) else "" end),
        (if .value.required == false then "optional" else "" end)
      ] | map(select(. != "")) | join(" ")
    )
    else "optional"
    end
  )
' "$CONFIG")

# -----------------------------------------------------------------------------
# Phase 2 — Resolve each variable in config order
# -----------------------------------------------------------------------------
resolve_variable() {
  local var="$1"
  local spec="$2"

  # Always check env override by the variable's own name first
  local env_val="${!var:-}"
  if [[ -n "$env_val" ]]; then
    RESOLVED["$var"]="$env_val"
    return
  fi

  # Parse spec tokens
  local alt_env="" gen_type="" inherit_from="" eval_expr="" default_val="" is_optional=false

  for token in $spec; do
    case "$token" in
      generate:password) gen_type="password" ;;
      generate:hex)      gen_type="hex" ;;
      generate:django)   gen_type="django" ;;
      inherit:*)         inherit_from="${token#inherit:}" ;;
      env:*)             alt_env="${token#env:}" ;;
      eval:*)            eval_expr="${token#eval:}" ;;
      default:*)         default_val="${token#default:}" ;;
      optional)          is_optional=true ;;
    esac
  done

  # Check alternate env var
  if [[ -n "$alt_env" ]]; then
    local alt_val="${!alt_env:-}"
    if [[ -n "$alt_val" ]]; then
      RESOLVED["$var"]="$alt_val"
      return
    fi
  fi

  # Inherit from another resolved variable
  if [[ -n "$inherit_from" ]]; then
    RESOLVED["$var"]="${RESOLVED[$inherit_from]:-}"
    return
  fi

  # Eval expression
  if [[ -n "$eval_expr" ]]; then
    RESOLVED["$var"]=$(eval "echo \"${eval_expr}\"" 2>/dev/null || echo "")
    return
  fi

  # Generate
  if [[ -n "$gen_type" ]]; then
    case "$gen_type" in
      password) RESOLVED["$var"]=$(generate_password "$var") ;;
      hex)      RESOLVED["$var"]=$(generate_hex) ;;
      django)   RESOLVED["$var"]=$(generate_django) ;;
    esac
    return
  fi

  # Static default
  if [[ -n "$default_val" ]]; then
    RESOLVED["$var"]="$default_val"
    return
  fi

  # Optional or unresolvable
  RESOLVED["$var"]=""
}

echo "🔧  Resolving variables ..."
while IFS=$'\t' read -r var spec; do
  [[ -z "$var" ]] && continue
  resolve_variable "$var" "$spec"
done <<< "$VARS_CACHE"
echo "    Resolved ${#RESOLVED[@]} variables"
echo ""

# -----------------------------------------------------------------------------
# Phase 3 — Preprocess mappings via single yq call
# -----------------------------------------------------------------------------
# Output format: FOLDER<TAB>KEY<TAB>VAR_REF (may have ? prefix)
# -----------------------------------------------------------------------------
MAPPINGS_CACHE=$(yq '
  .mappings | to_entries | .[] |
  .key as $folder |
  .value | to_entries | .[] |
  $folder + "\t" + .key + "\t" + (.value | tostring)
' "$CONFIG")

# -----------------------------------------------------------------------------
# Phase 4 — Apply mappings (set secrets in Infisical)
# -----------------------------------------------------------------------------
echo "🔐  Setting secrets ..."
current_folder=""
batch=0

while IFS=$'\t' read -r folder key var_ref; do
  [[ -z "$folder" ]] && continue

  if [[ "$folder" != "$current_folder" ]]; then
    # Wait for previous folder's batch before starting new folder
    if [[ -n "$current_folder" ]]; then
      wait
      batch=0
    fi
    current_folder="$folder"
    echo ""
    echo "  📁  $folder"
  fi

  # Check optional flag
  local_optional=false
  if [[ "$var_ref" == "?"* ]]; then
    local_optional=true
    var_ref="${var_ref#?}"
  fi

  local_value="${RESOLVED[$var_ref]:-}"

  if [[ -z "$local_value" && "$local_optional" == true ]]; then
    SKIPPED+=("${var_ref}")
    continue
  fi

  set_secret "$folder" "$key" "$local_value" &
  batch=$((batch+1))
  if (( batch % 6 == 0 )); then
    wait
    batch=0
  fi
done <<< "$MAPPINGS_CACHE"

wait
echo ""

# =============================================================================
# Summary
# =============================================================================
echo "=============================================="
echo "✅  Done!"
echo ""
echo "  Verify with:"
echo "    infisical secrets list --projectId $PROJECT_ID --env $ENV_SLUG --path /${SECRET_FOLDERS[0]} --domain $INFISICAL_HOST"

if [[ ${#SKIPPED[@]} -gt 0 ]]; then
  # Deduplicate
  mapfile -t UNIQUE_SKIPPED < <(printf '%s\n' "${SKIPPED[@]}" | sort -u)
  echo ""
  echo "  ⚠️   Skipped ${#UNIQUE_SKIPPED[@]} optional secrets (env vars not set):"
  for var in "${UNIQUE_SKIPPED[@]}"; do
    echo "       export $var=<value>"
  done
fi

echo "=============================================="
