#!/usr/bin/env bash
# =============================================================================
# Infisical Secret Population Engine
#
# Supports two config formats:
#   - v1 (apiVersion: secrets-tools/v1) — sections with dc get integration
#   - legacy (variables + mappings) — backward compatible
#
# Usage:
#   infisical-populate-secrets --env=prod [--dry-run]
#   infisical-populate-secrets --env=prod --section=data-postgres
#   infisical-populate-secrets --list
#   infisical-populate-secrets --github-push            (GitHub sync: plan only)
#   infisical-populate-secrets --github-apply ...       (GitHub sync: gated writes)
#
# Dependencies: yq (v4+), jq, curl, openssl, bash 4+; gh for --github-*
# =============================================================================
set -euo pipefail

# --assist: AI-powered help
_K8_ASSIST_LIB="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}/bin/assist.sh"
[[ -f "$_K8_ASSIST_LIB" ]] && { source "$_K8_ASSIST_LIB"; _k8_check_assist "$0" "$@"; }

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Absolute path to this script (so per-section children re-invoke *this* binary,
# not whatever happens to be first on PATH).
SELF_PATH="$0"
if [[ "$SELF_PATH" != /* ]]; then
  if [[ "$SELF_PATH" != */* ]] && command -v "$SELF_PATH" &>/dev/null; then
    SELF_PATH="$(command -v "$SELF_PATH")"
  else
    SELF_PATH="$PWD/$SELF_PATH"
  fi
fi
# User's current shell — children run inside it so direnv/rc/env are consistent.
RUN_SHELL="${SHELL:-/bin/zsh}"

# -- Parallel-dispatch helpers (zellij fan-out) -------------------------------
_shell_quote() {
  # single-quote a single token for safe shell re-use
  local s="$1"
  printf "'%s'" "${s//\'/\'\\\'\'}"
}
_kdl_quote() {
  # escape a string for a zellij KDL double-quoted attribute
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '"%s"' "$s"
}
_build_section_cmdline() {
  # Emit a fully shell-quoted command line: <self> --section <sec> [forwarded...]
  local sec="$1" out a
  out="$(_shell_quote "$SELF_PATH") $(_shell_quote --section) $(_shell_quote "$sec")"
  if (("${#FORWARD_ARGS[@]}")); then
    for a in "${FORWARD_ARGS[@]}"; do
      out+=" $(_shell_quote "$a")"
    done
  fi
  printf '%s' "$out"
}

# Resolve one --section arg against the config: a v1 group expands to its member
# section ids; a bare section id passes through; anything else is an error.
# Echoes zero or more newline-delimited resolved ids.
_resolve_section_arg() {
  local cfg="$1" arg="$2" members
  if ! yq -e '.apiVersion == "secrets-tools/v1"' "$cfg" &>/dev/null; then
    printf '%s\n' "$arg"; return 0
  fi
  members=$(yq -r ".groups.\"${arg}\"[]?" "$cfg" 2>/dev/null)
  if [[ -n "$members" ]]; then
    printf '%s\n' "$members"
    return 0
  fi
  if yq -e ".sections[] | select(.id == \"${arg}\")" "$cfg" &>/dev/null; then
    printf '%s\n' "$arg"
    return 0
  fi
  echo "❌  Unknown section/group: $arg" >&2
  return 1
}
# Decide whether multi-section dispatch applies: true when EITHER
#   - 2+ --section flags were passed, OR
#   - 1+ --section whose expansion yields 2+ distinct sections (e.g. a group).
# A single resolved section runs inline (no zellij).
_should_dispatch() {
  local cfg raw resolved="" cnt=0
  cfg="$(find_secrets_config "$CONFIG_ARG" 2>/dev/null || true)"
  [[ -z "$cfg" ]] && { echo "❌  No config file found." >&2; exit 1; }
  declare -A _seen=()
  for raw in "${SECTION_ARGS[@]}"; do
    resolved="$(_resolve_section_arg "$cfg" "$raw")" || exit 1
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      [[ -n "${_seen[$line]:-}" ]] && continue
      _seen[$line]=1
      cnt=$((cnt+1))
      (( cnt >= 2 )) && return 0
    done <<< "$resolved"
  done
  return 1
}

_run_parallel_dispatch() {
  # Expand every --section value (groups → member sections), dedupe preserving
  # order. Each resolved section id becomes its own tab.
  local cfg="" raw resolved=""
  cfg="$(find_secrets_config "$CONFIG_ARG" 2>/dev/null || true)"
  if [[ -z "$cfg" ]]; then
    echo "❌  No config file found (needed to expand groups)." >&2; exit 1
  fi

  local -a EXPANDED=() ; local -A _seen=() ; local arg line
  for arg in "${SECTION_ARGS[@]}"; do
    resolved="$(_resolve_section_arg "$cfg" "$arg")" || exit 1
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      [[ -n "${_seen[$line]:-}" ]] && continue
      _seen[$line]=1
      EXPANDED+=("$line")
    done <<< "$resolved"
  done
  if (("${#EXPANDED[@]}" == 0)); then
    echo "❌  No sections to run after expansion." >&2; exit 1
  fi
  local n="${#EXPANDED[@]}"

  if ! command -v zellij &>/dev/null; then
    echo "⚠️  zellij not found — running $n sections sequentially." >&2
    local sec
    for sec in "${EXPANDED[@]}"; do
      echo ""; echo "═══════ section: $sec ═══════"
      if (("${#FORWARD_ARGS[@]}")); then
        "$SELF_PATH" --section "$sec" "${FORWARD_ARGS[@]}" || true
      else
        "$SELF_PATH" --section "$sec" || true
      fi
    done
    exit 0
  fi

  local cwd="$PWD" session layout sec cmd
  session="ips-parallel-$(date +%s)"
  layout="$(mktemp -t ips-layout.XXXXXX.kdl)"
  trap 'rm -f "$layout"' EXIT INT TERM

  {
    echo 'layout {'
    echo '    default_tab_template {'
    echo '        pane size=1 borderless=true { plugin location="zellij:tab-bar" }'
    echo '        children'
    echo '        pane size=2 borderless=true { plugin location="zellij:status-bar" }'
    echo '    }'
    for sec in "${EXPANDED[@]}"; do
      cmd="$(_kdl_quote "$(_build_section_cmdline "$sec")")"
      printf '    tab name=%s {\n' "$(_kdl_quote "$sec")"
      printf '        pane {\n'
      printf '            command %s\n'  "$(_kdl_quote "$RUN_SHELL")"
      printf '            args "-c" %s\n' "$cmd"
      printf '            cwd %s\n'        "$(_kdl_quote "$cwd")"
      printf '        }\n'
      printf '    }\n'
    done
    echo '}'
  } > "$layout"

  echo "🚀  Launching zellij session '$session' — $n tabs (one per section)." >&2

  if [[ -n "${ZELLIJ:-}" ]]; then
    # Already inside zellij: add tabs to the current session (no nesting).
    for sec in "${EXPANDED[@]}"; do
      cmd="$(_build_section_cmdline "$sec")"
      zellij action new-tab --name "$sec" -- "$RUN_SHELL" -c "$cmd"
    done
    echo "✅  Opened $n tabs in the current zellij session." >&2
    exit 0
  fi
  # Not yet in zellij: create + attach. Replaces this process.
  exec zellij --layout "$layout" --session "$session"
}

# -- GitHub secret sync (repo Actions + environment scopes) -------------------
#
# Reconciles `github:` blocks in the secrets YAML to GitHub Actions secrets.
# Safety model (full reference: docs/howto/sync-github-secrets.md):
#   * Owner allowlist + expected login live HERE, in tracked code — never in
#     the gitignored YAML. A bad edit to that file must not be able to redirect
#     credentials to an unknown org.
#   * Three independent gates for live writes:
#       1. env   SECRET_UTILS_GITHUB_WRITES=1  (a YAML edit cannot set env vars)
#       2. flag  --github-push                  (plan only — never writes)
#       3. flag  --github-apply                 (typed plan-sha confirmation;
#            non-interactive: --yes AND --github-plan-sha=<sha of the plan>)
#   * Values travel ONLY via stdin pipes (printf '%s' …) — never argv, never
#     temp files, never log lines. gh stderr is scrubbed before display.
#   * Fail-fast on the first write error; append-only ledger; a wrongly-written
#     credential cannot be unwritten — only ROTATED.
#   * The config file is READ-ONLY: this feature never writes YAML back.
#   * Scope (v1): repository Actions secrets + environment secrets.
#     Organization and Dependabot scopes are deferred to v2 — the schema
#     rejects them with a specific reason (see docs/howto/sync-github-secrets.md
#     for the v2 requirements that must land with org support).
#
# NOTE (test extraction): tests/test_github_*.sh eval this whole region between
# the BEGIN/END markers below. Keep it self-contained.

# -- github-sync BEGIN --
GITHUB_SYNC_OWNER_ALLOWLIST="noizu-labs noizu-labs-ml the-robot-lives"
GITHUB_SYNC_OWNER_DENYLIST="noizu-forks"            # excluded entirely, by policy
GITHUB_SYNC_EXPECTED_LOGINS="noizu"                 # keyring identity; edit in tracked code
GITHUB_SYNC_WRITES_ENV="SECRET_UTILS_GITHUB_WRITES"
GITHUB_SYNC_LEDGER_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/secret-utils"

GH_JOB_META=()      # "sid|path|key|scope|owner/repo|env|as" per collected job
GH_JOB_VALUE=()     # normalized value, parallel to GH_JOB_META (never logged)
declare -A GH_ENV_PROTECTION=()  # "repo|env" -> protection_rules count (cache)
GH_BIN="${GH_BIN:-}"; GH_LOGIN=""; GH_AUTH_DESC="(unresolved)"
GH_PLAN_ROWS=()     # sorted "jobidx\x1fop\x1fsha8\x1fdisplay-line" rows
GH_PLAN_SHA=""
GH_ERRF="$(mktemp "${TMPDIR:-/tmp}/ghsync-err.XXXXXX")"
# (EXIT cleanup moved into the per-key summary trap in the Flags section.)

_sha256_stdin() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | cut -d' ' -f1
  else
    sha256sum | cut -d' ' -f1
  fi
}

_sha8_of_value() { printf '%s' "$1" | _sha256_stdin | cut -c1-8; }

_yq_json() {
  # yq with the v4.53 merge-WARN filtered from stderr (it fires on every
  # merge-key read). Do NOT pass --yaml-fix-merge-anchor-to-spec — it inverts
  # merge precedence at every `<<:` site.
  yq -o=json "$@" 2> >(grep -v -- '--yaml-fix-merge-anchor-to-spec' >&2 || true)
}

# Resolve YAML merge keys (`<<: *anchor`) defensively. Modern yq dereferences
# merge keys on read (with a WARN); older builds and edge syntaxes have been
# observed emitting a literal `<<` entry instead — which once created junk
# secrets literally NAMED `<<` in Infisical (taiga/plane incident). explode()
# is applied when the installed yq supports it; any surviving literal `<<`
# entry is dropped by the callers' select().
_explode_merge_keys() {
  if [[ -z "${SECRET_UTILS_HAVE_EXPLODE:-}" ]]; then
    if printf '{"a":1}' | yq -o=json 'explode(.)' - &>/dev/null; then
      SECRET_UTILS_HAVE_EXPLODE=true
    else
      SECRET_UTILS_HAVE_EXPLODE=false
    fi
  fi
  if [[ "$SECRET_UTILS_HAVE_EXPLODE" == true ]]; then
    yq -o=json 'explode(.)' - 2> >(grep -v -- '--yaml-fix-merge-anchor-to-spec' >&2 || true)
  else
    cat
  fi
}

_gh() {
  # NEVER call the bare word `gh` (alias/shim hazard). GH_BIN is resolved once
  # to an absolute, validated executable. The default strips ambient token env
  # so the keyring identity acts; --github-use-env-token opts back in. The
  # identity assertion (github_identity) still applies either way.
  if [[ "$GH_USE_ENV_TOKEN" == true ]]; then
    env -u GH_HOST -u GH_REPO "$GH_BIN" "$@"
  else
    env -u GH_TOKEN -u GITHUB_TOKEN -u GH_HOST -u GH_REPO "$GH_BIN" "$@"
  fi
}

_gh_scrub() {
  # Replace every resolved value occurrence with <redacted> (pure bash; the
  # values never enter another process's argv to get here). Indexed loop:
  # whole values only, never word-split — a value containing whitespace must
  # match as one unit (review note: value fragments are not secrets).
  local s="$1" i v
  for i in "${!GH_JOB_VALUE[@]}"; do
    v="${GH_JOB_VALUE[$i]}"
    [[ -n "$v" ]] && s="${s//"$v"/<redacted>}"
  done
  printf '%s' "$s"
}

github_owner_allowed() {
  local owner="$1"
  if [[ " $GITHUB_SYNC_OWNER_DENYLIST " == *" $owner "* ]]; then
    echo "❌  owner '$owner' is on the hard denylist ($GITHUB_SYNC_OWNER_DENYLIST) — excluded by policy." >&2
    return 1
  fi
  if [[ " $GITHUB_SYNC_OWNER_ALLOWLIST " != *" $owner "* ]]; then
    echo "❌  owner '$owner' is not in the tracked allowlist ($GITHUB_SYNC_OWNER_ALLOWLIST)." >&2
    echo "    The YAML can select owners but never extend this list — edit GITHUB_SYNC_OWNER_ALLOWLIST in" >&2
    echo "    bin/infisical-populate-secrets (tracked code) if this is intentional." >&2
    return 1
  fi
  return 0
}

github_valid_repo_slug() { [[ "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; }

github_valid_env_name() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]; }

github_valid_gh_name() {
  local n="$1"
  [[ "$n" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 1
  (( ${#n} <= 100 )) || return 1
  [[ "${n^^}" != GITHUB_* ]] || return 1
  return 0
}

_github_anchor_scan() { # _github_anchor_scan <config-file>
  # Refuse github: blocks reachable via YAML anchors / merge keys: one edit to
  # a template could attach the block to every `<<:` merge site. github blocks
  # must be literal and per-secret.
  local cfg="$1" bad=""
  if grep -Eq '^[[:space:]]*github:[[:space:]]*[&*]' "$cfg"; then
    echo "❌  github: value is a YAML anchor/alias — github blocks must be literal and per-secret." >&2
    return 1
  fi
  bad=$(awk '
    /^[ \t]*(#|$)/ { next }
    BEGIN { aind = -1 }
    {
      line = $0
      ind = 0
      while (substr(line, ind+1, 1) == " " || substr(line, ind+1, 1) == "\t") ind++
      payload = substr(line, ind+1)
      if (aind >= 0) {
        if (ind > aind || (ind == aind && payload ~ /^-/)) {
          if (payload ~ /github:/) { print payload; exit }
          next
        }
        aind = -1
      }
      if (payload ~ /&[A-Za-z_][A-Za-z0-9_-]*/) {
        if (payload ~ /github:/) { print payload; exit }
        aind = ind
      }
    }
  ' "$cfg")
  if [[ -n "$bad" ]]; then
    echo "❌  github: found inside a YAML anchor definition — github blocks must be literal and" >&2
    echo "    per-secret (an anchored block fans out to every '<<:' merge site). Offending line: $bad" >&2
    return 1
  fi
  return 0
}

github_validate_block() { # github_validate_block <sid> <key> <gh-json>
  local sid="$1" key="$2" gh="$3"
  local where="sections[${sid}].secrets.${key}.github"
  local tmp rt n
  tmp=$(jq -r '.as // empty' <<<"$gh")
  if [[ -z "$tmp" ]]; then
    echo "❌  $where: missing required key 'as' (the CI-side secret name — it genuinely differs from the store name)." >&2
    return 1
  fi
  if ! github_valid_gh_name "$tmp"; then
    echo "❌  $where: 'as: $tmp' is not a valid GitHub secret name (^[A-Za-z_][A-Za-z0-9_]*\$, <=100 chars, no GITHUB_* prefix)." >&2
    return 1
  fi
  tmp=$(jq -r '[keys[] | select(. != "as" and . != "trailing_newline" and . != "repo" and . != "environment")] | join(", ")' <<<"$gh")
  if [[ -n "$tmp" && "$tmp" != "null" ]]; then
    case "$tmp" in
      *org*)        echo "❌  $where: 'org:' scope is deferred to v2 (not implemented); use explicit repo: targets." >&2 ;;
      *dependabot*) echo "❌  $where: 'dependabot:' scope is deferred to v2 (not implemented); use explicit repo: targets." >&2 ;;
    esac
    if [[ "$tmp" == *app* ]]; then
      echo "❌  $where: 'app:' is not supported — actions only ('agents' and 'codespaces' are rejected)." >&2
    fi
    echo "❌  $where: unknown key(s) [$tmp] — allowed: as, trailing_newline, repo, environment." >&2
    return 1
  fi
  tmp=$(jq -r '.trailing_newline // "auto"' <<<"$gh")
  if [[ ! "$tmp" =~ ^(auto|strip|preserve)$ ]]; then
    echo "❌  $where: trailing_newline must be strip|preserve (got '$tmp')." >&2
    return 1
  fi
  rt=$(jq -r '.repo | type' <<<"$gh")
  if [[ "$rt" == "string" || "$rt" == "number" ]]; then
    echo "❌  $where: repo must be a LIST of owner/repo strings." >&2
    return 1
  fi
  local r
  while IFS= read -r r; do
    [[ -z "$r" ]] && continue
    if ! github_valid_repo_slug "$r"; then
      echo "❌  $where: repo entry '$r' is malformed — expected owner/repo." >&2
      return 1
    fi
    github_owner_allowed "${r%%/*}" || return 1
  done < <(jq -r '.repo[]?' <<<"$gh")
  n=$(jq -r '(.repo // []) | length - (unique | length)' <<<"$gh")
  if (( n > 0 )); then
    echo "❌  $where: duplicate entries in the repo list." >&2
    return 1
  fi
  rt=$(jq -r '.environment | type' <<<"$gh")
  if [[ "$rt" == "string" || "$rt" == "number" ]]; then
    echo "❌  $where: environment must be a LIST of {repo, env} maps." >&2
    return 1
  fi
  local e erepo eenv ekeys
  while IFS= read -r e; do
    [[ -z "$e" ]] && continue
    ekeys=$(jq -r 'keys | join(", ")' <<<"$e")
    if [[ "$ekeys" != "repo" && "$ekeys" != "env" && "$ekeys" != "env, repo" && "$ekeys" != "repo, env" ]]; then
      echo "❌  $where: environment entry has unknown key(s) [$ekeys] — allowed: repo, env." >&2
      return 1
    fi
    erepo=$(jq -r '.repo // empty' <<<"$e")
    eenv=$(jq -r '.env // empty' <<<"$e")
    if [[ -z "$erepo" || -z "$eenv" ]]; then
      echo "❌  $where: environment entry requires BOTH 'repo' (owner/repo) and 'env' (environment name); got repo='$erepo' env='$eenv'." >&2
      return 1
    fi
    if ! github_valid_repo_slug "$erepo"; then
      echo "❌  $where: environment repo '$erepo' is malformed — expected owner/repo." >&2
      return 1
    fi
    if ! github_valid_env_name "$eenv"; then
      echo "❌  $where: environment name '$eenv' is malformed (alphanumerics, '.', '_', '-' only)." >&2
      return 1
    fi
    github_owner_allowed "${erepo%%/*}" || return 1
  done < <(jq -c '.environment[]?' <<<"$gh")
  n=$(jq -r '(.repo // [] | length) + (.environment // [] | length)' <<<"$gh")
  if (( n == 0 )); then
    echo "❌  $where: no targets — provide 'repo:' and/or 'environment:'." >&2
    return 1
  fi
  return 0
}

github_validate_config() { # github_validate_config <cfg>
  local cfg="$1" owners json tsv sid key ghjson
  # Anchor/alias scan FIRST: an aliased github: also breaks yq's parse, and we
  # want the specific refusal, not a generic "could not parse".
  _github_anchor_scan "$cfg" || return 1
  owners=$(_yq_json 'has("github_owners")' "$cfg" | jq -r '.') || {
    echo "❌  Could not parse $cfg (yq failed)." >&2; return 1; }
  if [[ "$owners" == "true" ]]; then
    echo "❌  top-level 'github_owners' in the YAML is REFUSED — the owner allowlist is tracked code" >&2
    echo "    (bin/infisical-populate-secrets), not configurable from this file." >&2
    return 1
  fi
  json=$(_yq_json '.sections' "$cfg") || {
    echo "❌  Could not parse $cfg (yq failed)." >&2; return 1; }
  tsv=$(jq -r '.[] | .id as $sid | (.secrets // {}) | to_entries[] | select(.value.github != null) | [$sid, .key, (.value.github | tojson)] | @tsv' <<<"$json") || return 1
  while IFS=$'\t' read -r sid key ghjson; do
    [[ -z "${sid:-}" ]] && continue
    github_validate_block "$sid" "$key" "$ghjson" || return 1
  done <<< "$tsv"
  return 0
}

github_resolve_ghbin() {
  local cand="${GH_BIN:-}"
  if [[ -z "$cand" ]]; then
    cand="$(command -v gh 2>/dev/null || true)"
  fi
  if [[ -z "$cand" ]]; then
    echo "❌  gh (GitHub CLI) not found on PATH — required for --github-push/--github-apply. Set GH_BIN to override." >&2
    return 1
  fi
  if [[ "$cand" != /* && -f "$cand" ]]; then
    cand="$(cd "$(dirname "$cand")" && pwd)/$(basename "$cand")"
  fi
  if [[ ! -f "$cand" || ! -x "$cand" || "$cand" == *" "* ]]; then
    echo "❌  GH_BIN resolved to '$cand' — not an absolute executable file (alias or shim?). Point GH_BIN at the real GitHub CLI binary." >&2
    return 1
  fi
  GH_BIN="$cand"
  return 0
}

github_identity() {
  local out st
  if ! out=$(_gh api user 2>"$GH_ERRF"); then
    echo "❌  Could not resolve the GitHub identity (gh api user failed): $(_gh_scrub "$(head -c 200 "$GH_ERRF")")" >&2
    return 1
  fi
  GH_LOGIN=$(jq -r '.login // empty' <<<"$out")
  if [[ -z "$GH_LOGIN" ]]; then
    echo "❌  gh api user returned no login." >&2
    return 1
  fi
  st=$(_gh auth status --hostname github.com 2>&1 || true)
  GH_AUTH_DESC=$(printf '%s\n' "$st" | grep -E 'Logged in|Token:' | tr '\n' ' ' | cut -c1-200)
  [[ -z "$GH_AUTH_DESC" ]] && GH_AUTH_DESC="(auth status unavailable)"
  if [[ " $GITHUB_SYNC_EXPECTED_LOGINS " != *" $GH_LOGIN "* ]]; then
    echo "❌  Acting GitHub identity is '$GH_LOGIN' — not in the expected logins" >&2
    echo "    (GITHUB_SYNC_EXPECTED_LOGINS='$GITHUB_SYNC_EXPECTED_LOGINS', tracked code). Refusing: this is the guard" >&2
    echo "    against ambient bot tokens. Default is the keyring identity; --github-use-env-token opts into the" >&2
    echo "    env token and still passes this gate only if its login is expected." >&2
    echo "    Auth detail: $GH_AUTH_DESC" >&2
    return 1
  fi
  return 0
}

github_preflight() {
  if [[ "$CONFIG_VERSION" != "v1" ]]; then
    echo "❌  --github-push/--github-apply require apiVersion secrets-tools/v1 (got '$CONFIG_VERSION')." >&2
    exit 1
  fi
  github_resolve_ghbin || exit 1
  github_validate_config "$CONFIG" || exit 1
  github_identity || exit 1
  echo "🔑  GitHub sync: identity '$GH_LOGIN' ($GH_AUTH_DESC)"
  echo "     owner allowlist: $GITHUB_SYNC_OWNER_ALLOWLIST (denylist: $GITHUB_SYNC_OWNER_DENYLIST)"
  return 0
}

github_collect() { # github_collect <sid> <path> <key> <spec-json> <value>
  local sid="$1" path="$2" key="$3" spec="$4" value="$5"
  local gh as trailing mode r e erepo eenv
  gh=$(jq -c '.github // empty' <<<"$spec")
  [[ -z "$gh" ]] && return 0
  as=$(jq -r '.as' <<<"$gh")
  trailing=$(jq -r '.trailing_newline // "auto"' <<<"$gh")
  # trailing_newline: default strip for single-line values, preserve for
  # multi-line/PEM (a stray newline silently corrupts the secret, returns 2xx,
  # and cannot be read back to diagnose).
  mode="$trailing"
  if [[ "$mode" == "auto" ]]; then
    if [[ "${value%$'\n'}" == *$'\n'* ]]; then mode="preserve"; else mode="strip"; fi
  fi
  if [[ "$mode" == "strip" ]]; then
    while [[ "$value" == *$'\n' ]]; do value="${value%$'\n'}"; done
  fi
  while IFS= read -r r; do
    [[ -z "$r" ]] && continue
    GH_JOB_META+=("${sid}|${path}|${key}|repo|${r}|-|${as}")
    GH_JOB_VALUE+=("$value")
  done < <(jq -r '.repo[]?' <<<"$gh")
  while IFS= read -r e; do
    [[ -z "$e" ]] && continue
    erepo=$(jq -r '.repo' <<<"$e")
    eenv=$(jq -r '.env' <<<"$e")
    GH_JOB_META+=("${sid}|${path}|${key}|environment|${erepo}|${eenv}|${as}")
    GH_JOB_VALUE+=("$value")
  done < <(jq -c '.environment[]?' <<<"$gh")
  return 0
}

_github_api_fail() { # _github_api_fail <what> <raw-stderr>
  local what="$1" raw="$2"
  echo "❌  GET $what failed (acting identity: ${GH_LOGIN:-unresolved} — ${GH_AUTH_DESC:-})." >&2
  echo "    $(_gh_scrub "$raw" | head -c 400)" >&2
  if [[ "$raw" == *"HTTP 404"* ]]; then
    echo "    404 means: not found OR not visible to this identity — GitHub silently redirects" >&2
    echo "    renamed/transferred repos; double-check the exact owner/repo spelling." >&2
  elif [[ "$raw" == *"HTTP 403"* ]]; then
    echo "    403: insufficient scope or SSO. If the org requires SSO, authorize via the" >&2
    echo "    X-GitHub-SSO URL gh prints for a direct api call; repo secret writes need repo admin." >&2
  fi
  return 0
}

github_check_repo() { # github_check_repo <owner/repo>
  local want="$1" out body fn priv fork arch admin why=""
  if ! out=$(_gh api --include "repos/$want" 2>"$GH_ERRF"); then
    _github_api_fail "repos/$want" "$(<"$GH_ERRF")"
    return 1
  fi
  body="${out#*$'\n\n'}"
  fn=$(jq -r '.full_name // empty' <<<"$body")
  priv=$(jq -r '.private // false' <<<"$body")
  fork=$(jq -r '.fork // false' <<<"$body")
  arch=$(jq -r '.archived // false' <<<"$body")
  admin=$(jq -r '.permissions.admin // false' <<<"$body")
  if [[ -z "$fn" ]]; then
    echo "❌  repos/$want: unexpected API response (no full_name). Refusing." >&2
    return 1
  fi
  if [[ "${fn,,}" != "${want,,}" ]]; then
    echo "❌  repos/$want: GitHub reports full_name '$fn' — a rename/transfer redirect. Refusing: writing" >&2
    echo "    through a silent redirect sends credentials somewhere you did not name. Use '$fn' explicitly if intended." >&2
    return 1
  fi
  [[ "$priv" == "true" ]] || why+=" not-private"
  [[ "$fork" == "false" ]] || why+=" is-fork"
  [[ "$arch" == "false" ]] || why+=" archived"
  [[ "$admin" == "true" ]] || why+=" no-admin-permission"
  if [[ -n "$why" ]]; then
    echo "❌  repos/$want: refusing —$why." >&2
    return 1
  fi
  echo "  ✓ repo $want — private, admin, not fork/archived" >&2
  return 0
}

github_check_env() { # github_check_env <owner/repo> <env-name>
  local repo="$1" env="$2" enc out body prot raw
  enc=$(printf '%s' "$env" | jq -sRr @uri)
  if ! out=$(_gh api "repos/$repo/environments/$enc" 2>"$GH_ERRF"); then
    raw="$(<"$GH_ERRF")"
    echo "❌  environment '$env' does not exist on $repo — REFUSING to auto-create (a fresh environment" >&2
    echo "    has no protection rules; the secret would be repo-wide wearing a scoped name)." >&2
    echo "    Create it explicitly, then re-run:  $GH_BIN api --method PUT /repos/$repo/environments/$env" >&2
    if [[ "$raw" != *"HTTP 404"* ]]; then
      _github_api_fail "repos/$repo/environments/$enc" "$raw"
    fi
    return 1
  fi
  body="$out"
  prot=$(jq -r '.protection_rules | length' <<<"$body" 2>/dev/null || echo 0)
  GH_ENV_PROTECTION["${repo}|${env}"]="${prot:-0}"
  if [[ "${prot:-0}" == "0" ]]; then
    echo "  ⚠️  environment '$env' on $repo has NO protection rules — secrets in it are effectively" >&2
    echo "     repo-wide while looking scoped. Consider hardening:  $GH_BIN api --method PUT /repos/$repo/environments/$env" >&2
  fi
  return 0
}

_github_list_secrets() { # _github_list_secrets <repo> <env-or-empty>
  local repo="$1" env="$2" out
  if [[ -n "$env" ]]; then
    out=$(_gh secret list -R "$repo" --env "$env" --json name,updatedAt 2>"$GH_ERRF") || {
      _github_api_fail "secret list ($repo, env $env)" "$(<"$GH_ERRF")"; return 1; }
  else
    out=$(_gh secret list -R "$repo" --json name,updatedAt 2>"$GH_ERRF") || {
      _github_api_fail "secret list ($repo)" "$(<"$GH_ERRF")"; return 1; }
  fi
  jq -r '.[] | [.name, (.updatedAt // "-")] | @tsv' <<<"$out"
  return 0
}

github_plan_build() {
  local -i i j
  local sid path key scope repo env as value
  local -a idxs=()
  # Indexed loop: values are matched WHOLE — a sentinel or PEM with whitespace
  # must never be word-split into fragments before the check.
  for j in "${!GH_JOB_VALUE[@]}"; do
    value="${GH_JOB_VALUE[$j]}"
    if is_redaction_sentinel "$value"; then
      echo "❌  A secret destined for GitHub resolved to the dc redaction sentinel — resolution is broken" >&2
      echo "    (dc get without a real reveal). Refusing to plan or write." >&2
      return 1
    fi
  done
  for i in "${!GH_JOB_META[@]}"; do
    IFS='|' read -r sid path key scope repo env as <<< "${GH_JOB_META[$i]}"
    if [[ -n "$GH_REPO_FILTER" ]]; then
      [[ "${repo,,}" == "${GH_REPO_FILTER,,}" ]] || continue
    fi
    idxs+=("$i")
  done
  local -A repo_checked=() env_checked=() repo_secrets=() env_secrets=()
  for i in ${idxs[@]+"${idxs[@]}"}; do
    IFS='|' read -r sid path key scope repo env as <<< "${GH_JOB_META[$i]}"
    if [[ -z "${repo_checked[$repo]:-}" ]]; then
      github_check_repo "$repo" || return 1
      repo_checked[$repo]=1
      repo_secrets[$repo]="$(_github_list_secrets "$repo" "")" || return 1
    fi
    if [[ "$scope" == "environment" && -z "${env_checked[${repo}|${env}]:-}" ]]; then
      github_check_env "$repo" "$env" || return 1
      env_checked["${repo}|${env}"]=1
      env_secrets["${repo}|${env}"]="$(_github_list_secrets "$repo" "$env")" || return 1
    fi
  done
  # Dedupe is mandatory: the same slot can be reached from several collected
  # sources (e.g. an identical spec copy-pasted or merged into N sections —
  # same path/key, different section id). One DISTINCT store key per slot
  # (xN-sources display); two different store keys on one slot is an
  # ambiguity — hard error naming both.
  local -A tuple_store=() tuple_count=() tuple_row=() tuple_val=()
  local t sk
  for i in ${idxs[@]+"${idxs[@]}"}; do
    IFS='|' read -r sid path key scope repo env as <<< "${GH_JOB_META[$i]}"
    t="${scope}|${repo}|${env}|actions|${as}"   # 'actions' = the --app slot; v2 scopes slot in here
    sk="${path}/${key}"                          # the STORE key = Infisical coordinate
    if [[ -n "${tuple_store[$t]:-}" && "${tuple_store[$t]}" != "$sk" ]]; then
      echo "❌  Name collision on GitHub slot (scope=$scope target=$repo ${env:+env=$env }name='$as'):" >&2
      echo "    store keys '${tuple_store[$t]}' and '$sk' both target it. Rename one via 'as:'." >&2
      return 1
    fi
    if [[ -n "${tuple_val[$t]:-}" && "${tuple_val[$t]}" != "${GH_JOB_VALUE[$i]}" ]]; then
      echo "❌  Same GitHub slot (scope=$scope target=$repo ${env:+env=$env }name='$as') fed DIFFERENT values" >&2
      echo "    from one store key '$sk' (an 'auto:' spec resolved twice?). Refusing the ambiguity." >&2
      return 1
    fi
    tuple_store[$t]="$sk"
    tuple_count[$t]=$(( ${tuple_count[$t]:-0} + 1 ))
    tuple_row[$t]="$i"
    tuple_val[$t]="${GH_JOB_VALUE[$i]}"
  done
  GH_PLAN_ROWS=()
  local display op sha8 notes existing
  for t in "${!tuple_row[@]}"; do
    i="${tuple_row[$t]}"
    IFS='|' read -r sid path key scope repo env as <<< "${GH_JOB_META[$i]}"
    value="${GH_JOB_VALUE[$i]}"
    notes=""
    if (( ${tuple_count[$t]} > 1 )); then notes+="x${tuple_count[$t]}-sources "; fi
    if [[ "$scope" == "environment" ]]; then
      existing=$(printf '%s' "${env_secrets[${repo}|${env}]:-}" | awk -F'\t' -v n="$as" '$1==n{print $2; exit}')
    else
      existing=$(printf '%s' "${repo_secrets[$repo]:-}" | awk -F'\t' -v n="$as" '$1==n{print $2; exit}')
    fi
    if [[ -z "$value" ]]; then
      op="skip-empty"; sha8="--------"; notes+="EMPTY-RESOLUTION "
    else
      sha8=$(_sha8_of_value "$value")
      if [[ -n "$existing" ]]; then
        op="update"; notes+="updatedAt ${existing} "
      else
        op="create"
      fi
    fi
    if [[ "$scope" == "environment" && "${GH_ENV_PROTECTION[${repo}|${env}]:-0}" == "0" ]]; then
      notes+="env-NO-protection-rules "
    fi
    display=$(printf '%s | %s | %s | %s | %s | %s | %s | %s' \
      "$repo" "$scope" "${env:--}" "${path}/${key}" "$as" "$op" "$sha8" "${notes% }")
    GH_PLAN_ROWS+=("${i}"$'\x1f'"${op}"$'\x1f'"${sha8}"$'\x1f'"${display}")
  done
  local -a sorted=()
  local line
  if (( ${#GH_PLAN_ROWS[@]} > 0 )); then
    while IFS= read -r line; do sorted+=("$line"); done < <(printf '%s\n' "${GH_PLAN_ROWS[@]}" | LC_ALL=C sort -t$'\x1f' -k4,4)
    GH_PLAN_ROWS=("${sorted[@]}")
    # sha covers the DISPLAY table exactly as reviewed (metadata prefix stripped).
    GH_PLAN_SHA=$(printf '%s\n' "${GH_PLAN_ROWS[@]}" | while IFS= read -r line; do printf '%s\n' "$(_plan_display_line "$line")"; done | _sha256_stdin)
  else
    GH_PLAN_SHA=""
  fi
  return 0
}

_plan_display_line() { # strip "jobidx␟op␟sha8␟" metadata prefix from a plan row
  local d="${1#*$'\x1f'}"
  d="${d#*$'\x1f'}"
  d="${d#*$'\x1f'}"
  printf '%s' "$d"
}

github_plan_print() {
  echo ""
  echo "── GitHub secret sync plan ─────────────────────────────────"
  echo "identity : $GH_LOGIN — $GH_AUTH_DESC"
  echo "gh binary: $GH_BIN"
  if [[ "$GH_MODE" == "apply" && "$DRY_RUN" != true ]]; then
    echo "mode     : APPLY (live writes; gated)"
  else
    echo "mode     : PLAN ONLY — nothing will be written"
  fi
  echo ""
  local line
  if [[ "${#GH_PLAN_ROWS[@]}" -eq 0 ]]; then
    echo "(no write targets${GH_REPO_FILTER:+ matching --github-repo=$GH_REPO_FILTER})"
  else
    for line in "${GH_PLAN_ROWS[@]}"; do echo "$(_plan_display_line "$line")"; done
  fi
  echo ""
  echo "plan sha256: $GH_PLAN_SHA"
  echo ""
  echo "Legend: create = no GitHub secret with that name exists yet; update = the name exists and"
  echo "will be replaced. GitHub secrets are write-only — values cannot be read back, so"
  echo "drift/'unchanged' is undetectable and NEVER claimed. sha256 = first 8 hex of the resolved"
  echo "value digest (not the value). xN-sources = slot reached from N collected sources (deduped)."
  echo "skip-empty = local resolution was empty."
  return 0
}

github_confirm_apply() {
  if [[ "${!GITHUB_SYNC_WRITES_ENV:-}" != "1" ]]; then
    echo "❌  Live GitHub writes require ${GITHUB_SYNC_WRITES_ENV}=1 in the environment — a YAML edit cannot" >&2
    echo "    set an env var; this gate stays independent of the (unreviewed) config file." >&2
    return 1
  fi
  if [[ -t 0 ]]; then
    local answer=""
    printf 'Type the plan sha256 above to apply these writes (Ctrl-C to abort): '
    IFS= read -r answer
    if [[ "$answer" != "$GH_PLAN_SHA" ]]; then
      echo "❌  Confirmation sha mismatch — refusing (the plan may have drifted; re-run and re-confirm)." >&2
      return 1
    fi
  else
    if [[ "$ASSUME_YES" != true ]]; then
      echo "❌  Non-interactive apply requires --yes." >&2
      return 1
    fi
    if [[ -z "$GH_PLAN_SHA_ARG" ]]; then
      echo "❌  Non-interactive apply requires --github-plan-sha=<sha of the plan table> (binds this run" >&2
      echo "    to the exact plan you reviewed)." >&2
      return 1
    fi
    if [[ "$GH_PLAN_SHA_ARG" != "$GH_PLAN_SHA" ]]; then
      echo "❌  --github-plan-sha mismatch — plan drifted; refusing. Re-run --github-push, review, and pass the new sha." >&2
      return 1
    fi
  fi
  return 0
}

github_ledger_append() { # github_ledger_append <scope> <repo> <env> <name> <op> <sha8>
  if ! mkdir -p "$GITHUB_SYNC_LEDGER_DIR" 2>/dev/null; then
    echo "  ⚠️  Could not create ledger dir $GITHUB_SYNC_LEDGER_DIR — continuing without ledger entry." >&2
    return 0
  fi
  local f="$GITHUB_SYNC_LEDGER_DIR/github-writes.log"
  if [[ ! -f "$f" ]]; then
    : > "$f" && chmod 600 "$f"
  fi
  printf '%s | %s | %s | %s | %s | %s | %s | %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$GH_LOGIN" "$1" "$2" "${3:--}" "$4" "$5" "$6" >> "$f"
  return 0
}

_github_rotation_banner() { # _github_rotation_banner <written-target...>
  echo "" >&2
  echo "❌  ABORTED — fail-fast on the first error; remaining targets were NOT written. No auto-retry." >&2
  if (( $# > 0 )); then
    echo "LEDGER — already written this run (identity $GH_LOGIN):" >&2
    printf '      %s\n' "$@" >&2
    echo "" >&2
    echo "⚠️  ROTATION REQUIRED FOR: $*" >&2
    echo "    GitHub secrets cannot be read back or unwritten. Any listed target that should not have" >&2
    echo "    received this credential — or whose value you cannot vouch for — must be ROTATED at the" >&2
    echo "    source and re-synced." >&2
  fi
  return 0
}

github_apply() {
  local -i _had_x=0
  if [[ $- == *x* ]]; then _had_x=1; fi
  set +x   # never trace writes
  _github_apply_inner "$@"
  local -i _rc=$?
  if (( _had_x )); then set -x; fi
  return $_rc
}

_github_apply_inner() {
  local -a written=() empties=() args=()
  local line i rest op sha8 sid path key scope repo env as value rc raw
  for line in ${GH_PLAN_ROWS[@]+"${GH_PLAN_ROWS[@]}"}; do
    i="${line%%$'\x1f'*}"
    if [[ -z "${GH_JOB_VALUE[$i]:-}" ]]; then
      IFS='|' read -r sid path key scope repo env as <<< "${GH_JOB_META[$i]}"
      empties+=("${scope} ${repo} ${env:+env:$env }'$as' (store: ${path}/${key})")
    fi
  done
  if (( ${#empties[@]} > 0 )); then
    echo "❌  Refusing to apply: ${#empties[@]} target(s) resolved EMPTY — pin the dc source, set the" >&2
    echo "    override env, or mark the spec optional:" >&2
    printf '      %s\n' "${empties[@]}" >&2
    return 1
  fi
  for line in ${GH_PLAN_ROWS[@]+"${GH_PLAN_ROWS[@]}"}; do
    i="${line%%$'\x1f'*}"
    rest="${line#*$'\x1f'}"
    op="${rest%%$'\x1f'*}"
    rest="${rest#*$'\x1f'}"
    sha8="${rest%%$'\x1f'*}"
    IFS='|' read -r sid path key scope repo env as <<< "${GH_JOB_META[$i]}"
    value="${GH_JOB_VALUE[$i]}"
    args=(secret set "$as" -R "$repo")
    if [[ "$scope" == "environment" ]]; then
      args+=(--env "$env")
    fi
    # v2 seam: org/dependabot scopes add cases here (see docs/howto/sync-github-secrets.md).
    # Value goes ONLY on stdin — printf '%s' (builtin: no trailing newline, no argv exposure).
    # --body/-b/--env-file are banned by construction (never emitted).
    printf '%s' "$value" | _gh "${args[@]}" 2>"$GH_ERRF"
    rc=$?
    if (( rc != 0 )); then
      raw=$(_gh_scrub "$(head -c 600 "$GH_ERRF")")
      echo "❌  gh secret set FAILED (rc=$rc) for scope=$scope target=$repo ${env:+env=$env }name='$as':" >&2
      echo "    $raw" >&2
      echo "    (acting identity: $GH_LOGIN — name/target/rc only; the value is never logged)" >&2
      _github_rotation_banner ${written[@]+"${written[@]}"}
      return 1
    fi
    github_ledger_append "$scope" "$repo" "$env" "$as" "$op" "$sha8"
    written+=("${scope} ${repo} ${env:+env:$env }${as}")
    echo "  ✅ wrote scope=$scope target=$repo ${env:+env=$env }name='$as' (value via stdin; not logged)"
  done
  echo "✅  GitHub sync applied: ${#written[@]} write(s). Ledger: $GITHUB_SYNC_LEDGER_DIR/github-writes.log"
  return 0
}

github_run() {
  if [[ "${#GH_JOB_META[@]}" -eq 0 ]]; then
    echo "ℹ️  No 'github:' targets collected for this run — nothing to plan."
    rm -f "$GH_ERRF"
    return 0
  fi
  github_plan_build || { rm -f "$GH_ERRF"; return 1; }
  github_plan_print
  if $DRY_RUN; then
    echo ""
    echo "🔍  DRY RUN — --github-apply downgraded to PLAN ONLY."
    rm -f "$GH_ERRF"
    return 0
  fi
  if [[ "$GH_MODE" != "apply" ]]; then
    rm -f "$GH_ERRF"
    return 0
  fi
  if [[ "${#GH_PLAN_ROWS[@]}" -eq 0 ]]; then
    echo "ℹ️  Plan is empty${GH_REPO_FILTER:+ (--github-repo=$GH_REPO_FILTER matched nothing)} — nothing to apply."
    rm -f "$GH_ERRF"
    return 0
  fi
  github_confirm_apply || { rm -f "$GH_ERRF"; return 1; }
  github_apply || { rm -f "$GH_ERRF"; return 1; }
  rm -f "$GH_ERRF"
  return 0
}
# -- github-sync END --

# -- Per-key run summary -------------------------------------------------------
# Every outcome (created/updated/unchanged/skipped/error) is recorded to a
# temp file — safe across the legacy engine's background subshells — and
# rendered once at the end. Key NAMES only, never values.
SUMMARY_FILE="$(mktemp "${TMPDIR:-/tmp}/ips-summary.XXXXXX")"
record_result() { printf '%s\t%s\n' "$1" "$2" >> "$SUMMARY_FILE"; }
print_summary() {
  local st c
  echo ""
  echo "📊  Summary (key names only — never values):"
  for st in created updated unchanged skipped error; do
    c=$(awk -F'\t' -v s="$st" '$1==s' "$SUMMARY_FILE" 2>/dev/null | wc -l | tr -d ' ')
    printf '  %-9s %s\n' "${st}:" "${c:-0}"
  done
  if awk -F'\t' '$1=="skipped"' "$SUMMARY_FILE" 2>/dev/null | grep -q .; then
    echo "  skipped keys:"
    awk -F'\t' '$1=="skipped" {print "    " $2}' "$SUMMARY_FILE"
  fi
  if awk -F'\t' '$1=="error"' "$SUMMARY_FILE" 2>/dev/null | grep -q .; then
    echo "  error keys:"
    awk -F'\t' '$1=="error" {print "    " $2}' "$SUMMARY_FILE"
  fi
  return 0
}
trap '[[ -n "${SUMMARY_FILE:-}" ]] && rm -f "$SUMMARY_FILE" 2>/dev/null
      [[ -n "${GH_ERRF:-}" ]] && rm -f "$GH_ERRF" 2>/dev/null
      true' EXIT

# -- Flags --------------------------------------------------------------------
DRY_RUN=false; IMPACTED_ONLY=false; LIST_MODE=false; ALL_MODE=false; GET_HTTP_CODE=000; GET_FOUND=false
ENV_ARG=""; CONFIG_ARG=""
SECTION_ARG=""          # last single --section (kept for legacy behavior / non-v1)
SECTION_ARGS=()         # collected --section values (parallel dispatch)
FORWARD_ARGS=()         # every recognized flag + value EXCEPT --section, -fast/--fast/--parallel
# GitHub-sync flags (github-sync region holds the tracked constants).
GH_MODE="none"; GH_REPO_FILTER=""; GH_PLAN_SHA_ARG=""
GH_USE_ENV_TOKEN=false; ASSUME_YES=false
TARGETS_SPECIFIED=false; TARGETS_RAW=""
TARGET_INFISICAL=true; TARGET_GITHUB=false
SECRETS_FAILED=0

_next_is=""
_next_val_for=""
for arg in "$@"; do
  if [[ -n "$_next_is" ]]; then
    case "$_next_is" in
      env)     ENV_ARG="$arg"; FORWARD_ARGS+=("$arg") ;;
      config)  CONFIG_ARG="$arg"; FORWARD_ARGS+=("$arg") ;;
      github-repo)     GH_REPO_FILTER="$arg" ;;
      github-plan-sha) GH_PLAN_SHA_ARG="$arg" ;;
      targets)         TARGETS_SPECIFIED=true; TARGETS_RAW="$arg" ;;
      section)
        SECTION_ARG="$arg"
        SECTION_ARGS+=("$arg")
        # NOT forwarded — _build_section_cmdline injects the single per-pane --section
        ;;
    esac
    _next_is=""; continue
  fi
  case "$arg" in
    --dry-run)      DRY_RUN=true; FORWARD_ARGS+=("$arg") ;;
    --impacted)     IMPACTED_ONLY=true; FORWARD_ARGS+=("$arg") ;;
    --list)         LIST_MODE=true ;;
    --all)          ALL_MODE=true ;;
    # GitHub-sync flags — consumed here, NOT forwarded (github runs inline only).
    --github-push)           GH_MODE="plan" ;;
    --github-apply)          GH_MODE="apply" ;;
    --github-repo)           _next_is=github-repo ;;
    --github-repo=*)         GH_REPO_FILTER="${arg#--github-repo=}" ;;
    --github-plan-sha)       _next_is=github-plan-sha ;;
    --github-plan-sha=*)     GH_PLAN_SHA_ARG="${arg#--github-plan-sha=}" ;;
    --github-use-env-token)  GH_USE_ENV_TOKEN=true ;;
    --yes)                   ASSUME_YES=true ;;
    --targets)               _next_is=targets ;;
    --targets=*)             TARGETS_SPECIFIED=true; TARGETS_RAW="${arg#--targets=}" ;;
    --show-secrets)
      echo "❌  --show-secrets was never implemented and is now refused rather than silently ignored" >&2
      echo "    (it never affected output). Inspect values via 'dc get --reveal --raw' or the Infisical" >&2
      echo "    UI; GitHub targets are never value-printable." >&2
      exit 2 ;;
    --stage)        ENV_ARG="stage"; FORWARD_ARGS+=("$arg") ;;
    --prod)         ENV_ARG="prod"; FORWARD_ARGS+=("$arg") ;;
    --dev)          ENV_ARG="dev"; FORWARD_ARGS+=("$arg") ;;
    --env=*)        ENV_ARG="${arg#--env=}"; FORWARD_ARGS+=("$arg") ;;
    --config=*)     CONFIG_ARG="${arg#--config=}"; FORWARD_ARGS+=("$arg") ;;
    --section=*|--include=*)
      SECTION_ARG="${arg#*=}"
      SECTION_ARGS+=("$SECTION_ARG")
      # NOT forwarded — dispatcher injects one per-pane --section
      ;;
    --env)          _next_is=env; FORWARD_ARGS+=("$arg") ;;
    --config)       _next_is=config; FORWARD_ARGS+=("$arg") ;;
    --section|--include)
      _next_is=section
      ;;
    # Parallel-dispatch switches — consumed here, NOT forwarded to children.
    -fast|--fast|--parallel) : ;;
    --help|-h)
      cat <<'USAGE'
Usage: infisical-populate-secrets --env=<prod|staging> [OPTIONS]

  --env=ENV         Target environment (required for Infisical runs)
  --stage           Shorthand for --env=stage
  --prod            Shorthand for --env=prod
  --dev             Shorthand for --env=dev
  --config=FILE     Path to secrets YAML config
  --section=NAME    Run only matching section or group (repeatable)
  --include=NAME    Alias for --section=NAME (repeatable)
  --all             Run EVERY section — whole-file runs are refused unless
                    --all or at least one --section is given
  --list            List available sections/groups and exit
  --impacted        Hide unchanged secrets in output
  --dry-run         Show what would change without writing
  --targets=LIST    Comma list of targets: infisical,github. Default: infisical.
                    The --github-* flags default to github-only, so planning a
                    GitHub sync never triggers live Infisical writes as a side
                    effect. Pass --targets infisical,github to run both.

GitHub secret sync (repo Actions + environment scopes — docs/howto/sync-github-secrets.md):
  --github-push            Plan only: resolve targets and print the write plan
                           (never writes). Start here; review the table.
  --github-apply           Apply the plan. Gates (all required):
                           SECRET_UTILS_GITHUB_WRITES=1 in the environment, AND
                           typed plan-sha confirmation (interactive), OR
                           --yes --github-plan-sha=<sha> (non-interactive).
  --github-repo=O/R        Narrow the run to one repository
  --github-plan-sha=SHA    Bind a non-interactive apply to the reviewed plan
  --github-use-env-token   Use the ambient GH_TOKEN (default: keyring identity;
                           the acting login must still be in the expected list)

Parallel dispatch (multi-section):
  --section A --section B [--section C ...] [-fast|--parallel]
        When 2+ --section flags are given, spawns a zellij session with one
        tab per section, each running this tool for that single section plus
        all other passed flags. A single --section runs inline (no zellij).
        -fast / --fast / --parallel are consumed by the dispatcher and never
        forwarded to the per-section panes. When already inside zellij, tabs
        are added to the current session instead of nesting.
        Incompatible with --github-push/--github-apply (refused).
USAGE
      exit 0 ;;
    # Unknown/misspelled flags must fail LOUDLY: a silently-ignored flag once
    # turned a scoped run into a whole-file run (the --include* incident).
    --*)  echo "❌  Unknown flag: $arg (run with --help)" >&2; exit 2 ;;
    *)    echo "❌  Unexpected argument: $arg — all inputs are flags (run with --help)" >&2; exit 2 ;;
  esac
done
unset _next_is

# -- Post-parse validation (GitHub sync flag combinations) ---------------------
if [[ -n "$GH_REPO_FILTER" ]] && ! [[ "$GH_REPO_FILTER" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
  echo "❌  --github-repo expects owner/repo (got '$GH_REPO_FILTER')." >&2
  exit 2
fi
if [[ -n "$GH_REPO_FILTER" && "$GH_MODE" == "none" ]]; then
  echo "❌  --github-repo requires --github-push or --github-apply." >&2
  exit 2
fi
if [[ "$GH_MODE" != "none" ]]; then
  TARGET_GITHUB=true
  if ! $TARGETS_SPECIFIED; then
    TARGET_INFISICAL=false   # safe default: github flags never trigger live Infisical writes
  fi
fi
if $TARGETS_SPECIFIED; then
  TARGET_INFISICAL=false; TARGET_GITHUB=false
  IFS=',' read -r -a _tgt_tokens <<< "$TARGETS_RAW"
  for _tgt in "${_tgt_tokens[@]}"; do
    _tgt="${_tgt//[[:space:]]/}"
    case "$_tgt" in
      infisical) TARGET_INFISICAL=true ;;
      github)    TARGET_GITHUB=true ;;
      *) echo "❌  --targets accepts only: infisical,github (got '$_tgt')." >&2; exit 2 ;;
    esac
  done
  unset _tgt _tgt_tokens
fi
if [[ "$TARGET_GITHUB" == true && "$GH_MODE" == "none" ]]; then
  echo "❌  --targets including 'github' requires --github-push or --github-apply." >&2
  exit 2
fi

# -- Dependencies -------------------------------------------------------------
for cmd in yq jq curl; do
  command -v "$cmd" &>/dev/null || { echo "❌  $cmd required but not found." >&2; exit 1; }
done

find_secrets_config() {
  local arg="${1:-}"
  if [[ -n "$arg" ]]; then
    [[ -f "$arg" ]] && echo "$arg" && return 0
    return 1
  fi
  if [[ -n "${INFISICAL_SECRETS_FILE:-}" ]]; then
    [[ -f "$INFISICAL_SECRETS_FILE" ]] && echo "$INFISICAL_SECRETS_FILE" && return 0
    return 1
  fi

  local dir="$PWD"
  local candidate
  while [[ "$dir" != "/" ]]; do
    for candidate in \
      "$dir/.infisical-secrets.yaml" \
      "$dir/.infra-config.yaml" \
      "$dir/infisical-secrets.yaml" \
      "$dir/secrets.yaml"; do
      [[ -f "$candidate" ]] && echo "$candidate" && return 0
    done
    dir="$(dirname "$dir")"
  done
  return 1
}

# -- Config discovery ---------------------------------------------------------
CONFIG="$(find_secrets_config "$CONFIG_ARG" || true)"
[[ -z "$CONFIG" ]] && { echo "❌  No config file found." >&2; exit 1; }

CONFIG_VERSION="legacy"
yq -e '.apiVersion == "secrets-tools/v1"' "$CONFIG" &>/dev/null && CONFIG_VERSION="v1"

# -- --list mode --------------------------------------------------------------
if $LIST_MODE; then
  if [[ "$CONFIG_VERSION" == "v1" ]]; then
    echo "Sections:"
    yq '.sections[] | "  " + .id + " — " + .title' "$CONFIG"
    echo ""; groups=$(yq '.groups // {} | keys | .[]' "$CONFIG" 2>/dev/null)
    if [[ -n "$groups" ]]; then
      echo "Groups:"
      while IFS= read -r g; do
        echo "  ${g} → $(yq ".groups.\"${g}\" | join(\", \")" "$CONFIG")"
      done <<< "$groups"
    fi
  else
    echo "Folders:"; yq '.folders[]' "$CONFIG" 2>/dev/null
    echo ""; echo "Mappings:"; yq '.mappings | keys | .[]' "$CONFIG" 2>/dev/null
  fi
  exit 0
fi

# -- GitHub sync preflight ----------------------------------------------------
# Runs before any dispatch/env/auth: full config-wide validation (anchors,
# allowlist, per-block schema), gh binary resolution, and identity assertion.
if [[ "$GH_MODE" != "none" ]]; then
  github_preflight
fi

# -- Parallel dispatch --------------------------------------------------------
# Fan out when 2+ --section flags are passed, OR a single --section is a group
# that expands to 2+ member sections. Each resolved section → its own zellij tab
# running this tool with just that one --section plus all forwarded args. A lone
# resolved section falls through to the inline engine below (no zellij).
# GitHub sync is INCOMPATIBLE with the fan-out: N panes would write credentials
# with no shared ledger or ordering. Sequential inline runs only.
# -- Scope gate ----------------------------------------------------------------
# Whole-file runs must be explicit. An unscoped run silently ignores any
# misspelled section flag and writes EVERY section — that is how junk keys
# (literally named `<<`) and empty overwrites once spread project-wide.
# Refuse unless --all was passed, or at least one --section is set.
if [[ "$GH_MODE" == "none" ]] && [[ "$TARGET_INFISICAL" == true ]] && [[ "$ALL_MODE" != true ]] && (( ${#SECTION_ARGS[@]} == 0 )); then
  echo "❌  Refusing an implicit whole-file run." >&2
  echo "    Pass one or more --section=<id> flags, or --all to deliberately run every section." >&2
  exit 2
fi

if (("${#SECTION_ARGS[@]}")) && _should_dispatch; then
  if [[ "$GH_MODE" != "none" ]]; then
    echo "❌  --github-push/--github-apply cannot run under the multi-section zellij fan-out (N panes" >&2
    echo "    writing credentials with no shared ledger). Re-run with a single --section or none." >&2
    exit 1
  fi
  _run_parallel_dispatch
fi

# -- Environment --------------------------------------------------------------
ENV_SLUG="${ENV_ARG:-${INFISICAL_ENV:-$(dc get secrets infisical.env 2>/dev/null || true)}}"
if [[ "$GH_MODE" != "none" && "$ENV_SLUG" == "staging" ]]; then
  echo "❌  --github-* refuses --env=staging: a repository has ONE GitHub secret namespace — a staging" >&2
  echo "    run would overwrite PRODUCTION CI credentials. Use a distinct 'as:' name instead." >&2
  exit 1
fi
if [[ "$TARGET_INFISICAL" == true ]]; then
  [[ -z "$ENV_SLUG" ]] && { echo "❌  No environment specified. Use --env=prod" >&2; exit 1; }
  [[ "$ENV_SLUG" != "prod" && "$ENV_SLUG" != "staging" ]] && { echo "❌  Unknown env: $ENV_SLUG" >&2; exit 1; }
fi
$DRY_RUN && echo "🔍  DRY RUN — no secrets will be written" && echo ""

# -- Infisical connection + auth ----------------------------------------------
if [[ "$TARGET_INFISICAL" == true ]]; then
# Resolve from env, then dc, then project config
INFISICAL_HOST="${INFISICAL_HOST:-${K8_INFISICAL_HOST:-$(dc get secrets infisical.host 2>/dev/null || true)}}"
PROJECT_SLUG="${INFISICAL_PROJECT_SLUG:-${K8_INFISICAL_PROJECT_SLUG:-$(dc get secrets infisical.project_slug 2>/dev/null || true)}}"
ENV_SLUG="${ENV_SLUG:-$(dc get secrets infisical.env 2>/dev/null || echo prod)}"
PROJECT_ID="${INFISICAL_PROJECT_ID:-${K8_INFISICAL_PROJECT_ID:-}}"
EKS_OPERATOR_CLIENT_ID="${EKS_OPERATOR_CLIENT_ID:-${K8_INFISICAL_CLIENT_ID:-$(dc get secrets operator.client_id 2>/dev/null || true)}}"
EKS_OPERATOR_CLIENT_SECRET="${EKS_OPERATOR_CLIENT_SECRET:-${K8_INFISICAL_CLIENT_SECRET:-$(dc get secrets operator.client_secret 2>/dev/null || true)}}"

# If no PROJECT_ID but we have a slug, resolve it after auth
[[ -z "$INFISICAL_HOST" ]] && { echo "❌  INFISICAL_HOST not set (env, dc secrets.infisical.host, or K8_INFISICAL_HOST)" >&2; exit 1; }
INFISICAL_HOST="${INFISICAL_HOST%/api}"
INFISICAL_HOST="${INFISICAL_HOST%/}"
for v in EKS_OPERATOR_CLIENT_ID EKS_OPERATOR_CLIENT_SECRET; do
  [[ -z "${!v:-}" ]] && { echo "❌  $v is not set." >&2; exit 1; }
done

# Cloudflare Access headers (if Infisical is behind Zero Trust)
CF_ACCESS_ID="${CF_ACCESS_CLIENT_ID:-$(dc get cf access.client_id 2>/dev/null || true)}"
CF_ACCESS_SECRET="${CF_ACCESS_CLIENT_SECRET:-$(dc get cf access.client_secret 2>/dev/null || true)}"
CF_HEADERS=()
if [[ -n "$CF_ACCESS_ID" && -n "$CF_ACCESS_SECRET" ]]; then
  CF_HEADERS=(-H "CF-Access-Client-Id: ${CF_ACCESS_ID}" -H "CF-Access-Client-Secret: ${CF_ACCESS_SECRET}")
fi

echo "🔑  Logging in via universal auth ..."
API_TOKEN=$(curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -X POST "${INFISICAL_HOST}/api/v1/auth/universal-auth/login" \
  -H "Content-Type: application/json" \
  -d "{\"clientId\":\"${EKS_OPERATOR_CLIENT_ID}\",\"clientSecret\":\"${EKS_OPERATOR_CLIENT_SECRET}\"}" \
  | jq -r '.accessToken // empty')
[[ -z "$API_TOKEN" ]] && { echo "❌  Auth failed." >&2; exit 1; }

# Resolve project ID from slug if needed
if [[ -z "$PROJECT_ID" && -n "${PROJECT_SLUG:-}" ]]; then
  PROJECT_ID=$(curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -X GET "${INFISICAL_HOST}/api/v1/projects/slug/${PROJECT_SLUG}" \
    -H "Authorization: Bearer ${API_TOKEN}" \
    -H "Content-Type: application/json" | jq -r '.id // .project.id // empty')
fi
[[ -z "$PROJECT_ID" ]] && { echo "❌  Could not resolve project ID (set INFISICAL_PROJECT_ID or PROJECT_SLUG)" >&2; exit 1; }

echo "✅  Authenticated — env=$ENV_SLUG project=$PROJECT_ID config=$CONFIG (${CONFIG_VERSION})"
echo ""
else
  # GitHub-only run (no infisical target): no Infisical auth, no env gate.
  echo "🔑  GitHub-only run — Infisical auth skipped (targets: github)."
fi

# -- Generators ---------------------------------------------------------------
generate_password() { openssl rand -base64 "$(($1 * 2))" | tr -d '=+/' | cut -c1-"$1"; }
generate_hex() { openssl rand -hex "$1"; }

# -- Infisical API helpers ----------------------------------------------------
get_secret() {
  # Remote read with an EXPLICIT outcome: callers MUST branch on GET_HTTP_CODE.
  # A failed read (network, 401, 5xx) is NOT the same as an absent key —
  # silently treating it as absent invites overwriting a live value with
  # whatever the local source happens to resolve (or not resolve) to.
  # Sets: GET_HTTP_CODE (200 found · 404 absent · anything else = read failure)
  #       GET_FOUND    (true iff the key exists remotely)
  #       GET_VALUE    (secret value when found, else "")
  # Runs in the CALLER'S shell (never inside $()): the outcome globals must
  # survive the call — command substitution runs in a subshell and dies with it.
  local resp code body val
  resp=$(curl -sS -w $'\n%{http_code}' ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -X GET \
    "${INFISICAL_HOST}/api/v3/secrets/raw/${2}?workspaceId=${PROJECT_ID}&environment=${ENV_SLUG}&secretPath=${1}" \
    -H "Authorization: Bearer ${API_TOKEN}" 2>/dev/null)
  code="${resp##*$'\n'}"
  body="${resp%$'\n'*}"
  GET_HTTP_CODE="${code:-000}"
  GET_VALUE=""
  if [[ "$GET_HTTP_CODE" == "200" ]]; then
    if val=$(jq -r '.secret.secretValue // ""' <<<"$body" 2>/dev/null); then
      GET_FOUND=true
      GET_VALUE="$val"
    else
      GET_FOUND=false
      GET_HTTP_CODE=000
    fi
  else
    GET_FOUND=false
  fi
  return 0
}

# True if value is a dc redaction mask (must never be written to Infisical).
# Kept in this script so install works even when lib/ is stale; also exported
# via secret-engine.sh as is_redaction_sentinel for unit tests.
is_redaction_sentinel() {
  local value="${1:-}"
  case "$value" in
    '🔒 **redacted**'|'🔒**redacted**'|'🔒❗ **redacted**'|'**redacted**')
      return 0
      ;;
  esac
  # Variant-safe: a short string whose only content is a redaction token.
  if [[ "$value" == *'**redacted**'* ]] && [[ ${#value} -le 40 ]]; then
    return 0
  fi
  return 1
}

set_secret() {
  local path="$1" key="$2" value="$3"
  local current json_value http_code body
  get_secret "$path" "$key"
  current="$GET_VALUE"

  # (b) A failed remote read is NOT an absent key: abort THIS key loudly rather
  # than write over an unknown remote state.
  if [[ "$GET_HTTP_CODE" != "200" && "$GET_HTTP_CODE" != "404" ]]; then
    record_result error "${path}/${key}"
    echo "  ❌  ERROR ${path}/${key} — remote GET failed (HTTP ${GET_HTTP_CODE}); key NOT touched"
    return 1
  fi

  # (a) A locally-empty resolution (unset dc key, non-interactive shell, missing
  # override) must never blank an existing remote value — nor create an empty one.
  if [[ -z "$value" ]]; then
    record_result skipped "${path}/${key}"
    if [[ -n "$current" ]]; then
      echo "  ⚠️   ${path}/${key} — skipped: empty source (remote has a value; NOT overwriting — pin the dc source, set the override env, or mark optional)"
    else
      echo "  ⚠️   ${path}/${key} — skipped: empty source (remote absent; nothing to create)"
    fi
    return 0
  fi

  # Never push dc's human redaction mask into Infisical (would corrupt a live secret).
  if is_redaction_sentinel "$value"; then
    record_result skipped "${path}/${key}"
    echo "  ⚠️   ${path}/${key} — skipped: REDACTION SENTINEL in source (dc get without real reveal): NOT writing"
    return 0
  fi

  json_value=$(printf '%s' "$value" | jq -Rs .)

  if $DRY_RUN; then
    if [[ "$GET_FOUND" != true ]]; then
      echo "  🆕  ${path}/${key}"
      record_result created "${path}/${key}"
    elif [[ "$current" == "$value" ]]; then
      $IMPACTED_ONLY || echo "  ▪️   ${path}/${key}"
      record_result unchanged "${path}/${key}"
    else
      echo "  ✅  ${path}/${key}"
      record_result updated "${path}/${key}"
    fi
    return 0
  fi

  # Body goes to curl on STDIN (-d @-): the JSON carries the secret value, and
  # -d "<string>" would expose it in the process list (ps/argv).
  body="{\"workspaceId\":\"${PROJECT_ID}\",\"environment\":\"${ENV_SLUG}\",\"secretPath\":\"${path}\",\"secretValue\":${json_value},\"type\":\"shared\"}"

  if [[ "$GET_FOUND" != true ]]; then
    http_code=$(printf '%s' "$body" | curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -o /dev/null -w "%{http_code}" \
      -X POST "${INFISICAL_HOST}/api/v3/secrets/raw/${key}" \
      -H "Authorization: Bearer ${API_TOKEN}" -H "Content-Type: application/json" \
      -d @-)
    if [[ "$http_code" == "400" ]]; then
      # Race: the key appeared between our GET and POST — update instead.
      http_code=$(printf '%s' "$body" | curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -o /dev/null -w "%{http_code}" \
        -X PATCH "${INFISICAL_HOST}/api/v3/secrets/raw/${key}" \
        -H "Authorization: Bearer ${API_TOKEN}" -H "Content-Type: application/json" \
        -d @-)
      if [[ "$http_code" == "200" ]]; then
        echo "  ✅  ${path}/${key}"
        record_result updated "${path}/${key}"
        return 0
      fi
    elif [[ "$http_code" == "200" || "$http_code" == "201" ]]; then
      echo "  🆕  ${path}/${key}"
      record_result created "${path}/${key}"
      return 0
    fi
    record_result error "${path}/${key}"
    echo "  ❌  ${path}/${key} (HTTP ${http_code})"
    return 1
  fi

  if [[ "$current" == "$value" ]]; then
    $IMPACTED_ONLY || echo "  ▪️   ${path}/${key}"
    record_result unchanged "${path}/${key}"
    return 0
  fi

  http_code=$(printf '%s' "$body" | curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -o /dev/null -w "%{http_code}" \
    -X PATCH "${INFISICAL_HOST}/api/v3/secrets/raw/${key}" \
    -H "Authorization: Bearer ${API_TOKEN}" -H "Content-Type: application/json" \
    -d @-)
  if [[ "$http_code" == "200" ]]; then
    echo "  ✅  ${path}/${key}"
    record_result updated "${path}/${key}"
    return 0
  fi
  record_result error "${path}/${key}"
  echo "  ❌  ${path}/${key} (HTTP ${http_code})"
  return 1
}

# -- Folder creation (nested paths) ------------------------------------------
ensure_folder_segment() {
  curl -s -o /dev/null -w "" \
    ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} \
    -X POST "${INFISICAL_HOST}/api/v2/folders" \
    -H "Authorization: Bearer ${API_TOKEN}" -H "Content-Type: application/json" \
    -d "{\"projectId\":\"${PROJECT_ID}\",\"environment\":\"${ENV_SLUG}\",\"name\":\"${1}\",\"path\":\"${2}\"}" \
    2>/dev/null || true
}

ensure_folder_path() {
  local segments="${1#/}" current="/" IFS='/'
  for seg in $segments; do
    [[ -z "$seg" ]] && continue
    ensure_folder_segment "$seg" "$current"
    current="${current%/}/${seg}"
  done
}

# =============================================================================
# STAGING: copy prod → staging
# =============================================================================
if [[ "$ENV_SLUG" == "staging" ]]; then
  echo "📋  Copying all secrets from prod → staging ..."
  if [[ "$CONFIG_VERSION" == "v1" ]]; then
    mapfile -t FOLDERS < <(yq '.sections[].path' "$CONFIG")
  else
    mapfile -t FOLDERS < <(yq '.folders[]' "$CONFIG")
  fi
  for folder in "${FOLDERS[@]}"; do
    $DRY_RUN || ensure_folder_path "$folder"
    keys=$(curl -s -X GET \
      "${INFISICAL_HOST}/api/v3/secrets/raw?workspaceId=${PROJECT_ID}&environment=prod&secretPath=${folder}&recursive=false" \
      -H "Authorization: Bearer ${API_TOKEN}" | jq -r '.secrets[]?.secretKey // empty' 2>/dev/null)
    if [[ -z "$keys" ]]; then echo "  ⚠️   ${folder} — empty in prod"; continue; fi
    echo "  📁  ${folder}"
    while IFS= read -r key; do
      val=$(curl -s -X GET \
        "${INFISICAL_HOST}/api/v3/secrets/raw/${key}?workspaceId=${PROJECT_ID}&environment=prod&secretPath=${folder}" \
        -H "Authorization: Bearer ${API_TOKEN}" | jq -r '.secret.secretValue // empty' 2>/dev/null || true)
      if [[ -n "$val" ]]; then
        set_secret "$folder" "$key" "$val" || SECRETS_FAILED=$((SECRETS_FAILED+1))
      fi
    done <<< "$keys"
  done
  print_summary
  if (( SECRETS_FAILED > 0 )); then
    echo ""; echo "❌  Done — copied prod → staging with $SECRETS_FAILED FAILED secret write(s)."; exit 1
  fi
  echo ""; echo "✅  Done — copied prod → staging"; exit 0
fi

# =============================================================================
# V1 ENGINE
# =============================================================================
if [[ "$CONFIG_VERSION" == "v1" ]]; then

  # Resolve target sections
  if [[ -n "$SECTION_ARG" ]]; then
    target_sections=$(yq -r ".groups.\"${SECTION_ARG}\"[]?" "$CONFIG" 2>/dev/null)
    if [[ -z "$target_sections" ]]; then
      yq -e ".sections[] | select(.id == \"${SECTION_ARG}\")" "$CONFIG" &>/dev/null \
        && target_sections="$SECTION_ARG" \
        || { echo "❌  Unknown section/group: $SECTION_ARG" >&2; exit 1; }
    fi
  else
    target_sections=$(yq -r '.sections[].id' "$CONFIG")
  fi

  declare -A SECTION_RESOLVED

  resolve_dc_value() {
    local spec_json="$1"
    local dc_field dc_config dc_path
    dc_field=$(echo "$spec_json" | jq -r '.dc // empty')
    [[ -z "$dc_field" ]] && return
    read -r dc_config dc_path <<< "$dc_field"
    # ALWAYS --reveal for machine resolution: without it encrypted .envrc.dc
    # values become the redaction mask "🔒 **redacted**" and would overwrite
    # Infisical (non-empty PATCH). --raw avoids decorative wrappers.
    local cmd=(dc get "$dc_config" "$dc_path" --reveal --raw)
    local v
    v=$(echo "$spec_json" | jq -r '.override // empty'); [[ -n "$v" ]] && cmd+=(--override "$v")
    v=$(echo "$spec_json" | jq -r '.fallback // empty'); [[ -n "$v" ]] && cmd+=(--fallback "$v")
    v=$(echo "$spec_json" | jq -r '.auto // empty')
    if [[ -n "$v" ]]; then read -ra parts <<< "$v"; cmd+=(--auto "${parts[@]}"); fi
    v=$(echo "$spec_json" | jq -r '.default // empty'); [[ -n "$v" ]] && cmd+=(--default "$v")
    local out
    out=$("${cmd[@]}" 2>/dev/null || true)
    # Defense in depth: never return a redaction sentinel as a "resolved" value.
    if is_redaction_sentinel "$out"; then
      return 0
    fi
    printf '%s' "$out"
  }

  resolve_file_value() {
    local spec_json="$1"
    local override file_path decode
    override=$(echo "$spec_json" | jq -r '.override // empty')
    decode=$(echo "$spec_json" | jq -r '.decode // empty')
    if [[ -n "$override" ]]; then
      local env_val="${!override:-}"
      if [[ -n "$env_val" ]]; then
        [[ "$decode" == "base64" ]] && { printf '%s' "$env_val" | base64 -d 2>/dev/null || printf '%s' "$env_val"; } || printf '%s' "$env_val"
        return
      fi
    fi
    file_path=$(echo "$spec_json" | jq -r '.file // empty')
    if [[ -n "$file_path" ]]; then
      [[ "$file_path" != /* ]] && file_path="$REPO_ROOT/$file_path"
      [[ -f "$file_path" ]] && cat "$file_path"
    fi
  }

  render_template() {
    local tmpl="$1"
    while [[ "$tmpl" =~ \{\{([a-zA-Z_][a-zA-Z0-9_]*)(\|([a-zA-Z_]+))?\}\} ]]; do
      local var="${BASH_REMATCH[1]}" filter="${BASH_REMATCH[3]:-}" val="${SECTION_RESOLVED[${BASH_REMATCH[1]}]:-}"
      # urlencode via STDIN (herestring), not sys.argv — argv is visible in ps.
      # Exactly one trailing newline is stripped: that is the herestring's own.
      if [[ "$filter" == "urlencode" ]]; then
        val="$(python3 -c 'import urllib.parse,sys; s=sys.stdin.read(); print(urllib.parse.quote(s[:-1] if s.endswith("\n") else s, safe=""))' <<<"$val" 2>/dev/null)"
      fi
      tmpl="${tmpl//"${BASH_REMATCH[0]}"/$val}"
    done
    printf '%s' "$tmpl"
  }

  resolve_value() {
    # NOTE: always exit 0. Under `set -euo pipefail`, a non-zero return here
    # (e.g. the terminal `[[ -n ]] && printf` evaluating false when a value
    # resolves empty) aborts the whole script mid-section via the command
    # substitutions in the vars/secrets loops. Every branch must `return 0`.
    local s="$1" v
    v=$(echo "$s" | jq -r '.ref // empty')
    if [[ -n "$v" ]]; then printf '%s' "${SECTION_RESOLVED[$v]:-}"; return 0; fi
    v=$(echo "$s" | jq -r '.template // empty')
    if [[ -n "$v" ]]; then render_template "$v"; return 0; fi
    v=$(echo "$s" | jq -r '.file // empty')
    if [[ -n "$v" ]]; then resolve_file_value "$s"; return 0; fi
    v=$(echo "$s" | jq -r '.env // empty')
    if [[ -n "$v" ]]; then printf '%s' "${!v:-}"; return 0; fi
    v=$(echo "$s" | jq -r '.dc // empty')
    if [[ -n "$v" ]]; then
      local r; r=$(resolve_dc_value "$s")
      if [[ -n "$r" ]]; then printf '%s' "$r"; return 0; fi
    fi
    v=$(echo "$s" | jq -r '.fallback_dc // empty')
    if [[ -n "$v" ]]; then
      local fb; fb=$(echo "$s" | jq -c "{dc: .fallback_dc, override: .override, fallback: .fallback}")
      local r; r=$(resolve_dc_value "$fb")
      if [[ -n "$r" ]]; then printf '%s' "$r"; return 0; fi
    fi
    v=$(echo "$s" | jq -r '.default // empty')
    [[ -n "$v" ]] && printf '%s' "$v"
    return 0
  }

  # Process sections
  while IFS= read -r sid; do
    [[ -z "$sid" ]] && continue
    s_title=$(yq -r ".sections[] | select(.id == \"${sid}\") | .title" "$CONFIG")
    s_path=$(yq -r ".sections[] | select(.id == \"${sid}\") | .path" "$CONFIG")
    echo "── ${s_title} [${s_path}] ──"
    if [[ "$TARGET_INFISICAL" == true ]] && ! $DRY_RUN; then
      ensure_folder_path "$s_path"
    fi

    # Phase A: vars
    SECTION_RESOLVED=()
    while IFS=$'\t' read -r vn vs; do
      [[ -z "$vn" ]] && continue
      SECTION_RESOLVED["$vn"]=$(resolve_value "$vs")
    done < <(_yq_json ".sections[] | select(.id == \"${sid}\") | .vars // {}" "$CONFIG" | _explode_merge_keys | jq -r 'to_entries[] | select(.key != "<<") | .key + "\t" + (.value | tojson)')

    # Phase B: secrets
    while IFS=$'\t' read -r key spec; do
      [[ -z "$key" ]] && continue
      local_val=$(resolve_value "$spec")
      if [[ -z "$local_val" && "$(echo "$spec" | jq -r '.optional // false')" == "true" ]]; then
        $IMPACTED_ONLY || echo "  ⏭️   ${s_path}/${key} (optional, skipped)"
        continue
      fi
      if [[ "$TARGET_GITHUB" == true ]]; then
        github_collect "$sid" "$s_path" "$key" "$spec" "$local_val"
      fi
      if [[ "$TARGET_INFISICAL" == true ]]; then
        set_secret "$s_path" "$key" "$local_val" || SECRETS_FAILED=$((SECRETS_FAILED+1))
      fi
    done < <(_yq_json ".sections[] | select(.id == \"${sid}\") | .secrets // {}" "$CONFIG" | _explode_merge_keys | jq -r 'to_entries[] | select(.key != "<<") | .key + "\t" + (.value | tojson)')
    echo ""
  done <<< "$target_sections"

  if [[ "$GH_MODE" != "none" ]]; then
    github_run || exit 1
  fi
  print_summary
  if (( SECRETS_FAILED > 0 )); then
    echo "❌  Done — $SECRETS_FAILED Infisical secret write(s) FAILED."
    exit 1
  fi
  echo "✅  Done!"; exit 0
fi

# =============================================================================
# LEGACY ENGINE (variables + mappings)
# =============================================================================
mapfile -t SECRET_FOLDERS < <(yq '.folders[]' "$CONFIG")

if $DRY_RUN; then echo "📂  Skipping folder creation (dry run)"
else
  echo "📂  Ensuring secret folders ..."; batch=0
  for f in "${SECRET_FOLDERS[@]}"; do
    ensure_folder_segment "$f" "/" & batch=$((batch+1)); (( batch % 4 == 0 )) && wait
  done; wait
fi
echo ""

declare -A RESOLVED; SKIPPED=()
VARS_CACHE=$(yq '
  .variables | to_entries | map(select(.key != "<<")) | .[] |
  .key + "\t" + (
    if (.value | type) == "!!str" then .value
    elif (.value | type) == "!!map" then (
      [(if .value.env then "env:" + .value.env else "" end),
       (if .value.generate then "generate:" + .value.generate else "" end),
       (if .value.inherit then "inherit:" + .value.inherit else "" end),
       (if .value.eval then "eval:" + .value.eval else "" end),
       (if .value.default then "default:" + (.value.default | tostring) else "" end),
       (if .value.required == false then "optional" else "" end)
      ] | map(select(. != "")) | join(" "))
    else "optional" end)
' "$CONFIG")

resolve_variable() {
  local var="$1" spec="$2" env_val="${!1:-}"
  [[ -n "$env_val" ]] && { RESOLVED["$var"]="$env_val"; return; }
  local alt_env="" gen="" inherit="" eval_e="" default="" opt=false
  for tok in $spec; do
    case "$tok" in
      generate:password|generate:hex|generate:django) gen="${tok#generate:}" ;;
      inherit:*) inherit="${tok#inherit:}" ;; env:*) alt_env="${tok#env:}" ;;
      eval:*) eval_e="${tok#eval:}" ;; default:*) default="${tok#default:}" ;; optional) opt=true ;;
    esac
  done
  if [[ -n "$alt_env" ]]; then local av="${!alt_env:-}"; [[ -n "$av" ]] && { RESOLVED["$var"]="$av"; return; }; fi
  [[ -n "$inherit" ]] && { RESOLVED["$var"]="${RESOLVED[$inherit]:-}"; return; }
  [[ -n "$eval_e" ]]  && { RESOLVED["$var"]=$(eval "echo \"${eval_e}\"" 2>/dev/null || echo ""); return; }
  if [[ -n "$gen" ]]; then
    case "$gen" in
      password) RESOLVED["$var"]=$(generate_password 32) ;; hex) RESOLVED["$var"]=$(generate_hex 32) ;;
      django) RESOLVED["$var"]=$(python3 -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#\$%^&*(-_=+)') for _ in range(50)))" 2>/dev/null || generate_hex 32) ;;
    esac; return
  fi
  [[ -n "$default" ]] && { RESOLVED["$var"]="$default"; return; }
  RESOLVED["$var"]=""
}

echo "🔧  Resolving variables ..."
while IFS=$'\t' read -r var spec; do
  [[ -z "$var" ]] && continue; resolve_variable "$var" "$spec"
done <<< "$VARS_CACHE"
echo "    Resolved ${#RESOLVED[@]} variables"; echo ""

MAPPINGS_CACHE=$(yq '
  .mappings | to_entries | map(select(.key != "<<")) | .[] | .key as $f |
  .value | to_entries | map(select(.key != "<<")) | .[] | $f + "\t" + .key + "\t" + (.value | tostring)
' "$CONFIG")

echo "🔐  Setting secrets ..."
cur_folder=""; batch=0
BG_PIDS=()
_wait_bg() {
  # Wait for tracked set_secret children and COUNT failures (a bare `wait`
  # discards exit codes, so this script used to exit 0 after failed writes).
  local p
  for p in "${BG_PIDS[@]:-}"; do
    [[ -z "$p" ]] && continue
    wait "$p" || SECRETS_FAILED=$((SECRETS_FAILED+1))
  done
  BG_PIDS=()
}
while IFS=$'\t' read -r folder key var_ref; do
  [[ -z "$folder" ]] && continue
  if [[ "$folder" != "$cur_folder" ]]; then
    if [[ -n "$cur_folder" ]]; then _wait_bg; batch=0; fi
    cur_folder="$folder"; echo ""; echo "  📁  $folder"
  fi
  loc_opt=false
  [[ "$var_ref" == "?"* ]] && loc_opt=true && var_ref="${var_ref#?}"
  loc_val="${RESOLVED[$var_ref]:-}"
  [[ -z "$loc_val" && "$loc_opt" == true ]] && { SKIPPED+=("$var_ref"); continue; }
  set_secret "$folder" "$key" "$loc_val" & BG_PIDS+=($!); batch=$((batch+1)); (( batch % 6 == 0 )) && _wait_bg
done <<< "$MAPPINGS_CACHE"
_wait_bg; echo ""
print_summary

echo "=============================================="
if (( SECRETS_FAILED > 0 )); then
  echo "❌  Done — $SECRETS_FAILED secret write(s) FAILED."
fi
echo "✅  Done!"
if [[ ${#SKIPPED[@]} -gt 0 ]]; then
  mapfile -t UNIQUE < <(printf '%s\n' "${SKIPPED[@]}" | sort -u)
  echo "  ⚠️   Skipped ${#UNIQUE[@]} optional secrets:"
  for v in "${UNIQUE[@]}"; do echo "       export $v=<value>"; done
fi
echo "=============================================="
[[ "$SECRETS_FAILED" -eq 0 ]] || exit 1

