#!/usr/bin/env bash
# =============================================================================
# Infisical Secret Population Script
# Project: ${K8_INFISICAL_PROJECT_NAME}  |  Environments: prod, staging
# Host:    ${K8_INFISICAL_HOST}
#
# Usage:
#   infisical-populate-secrets --env=prod [--dry-run] [--show-secrets]
#   infisical-populate-secrets --env=staging [--dry-run]
#
# Staging copies all secrets from prod. Prod resolves from env vars or generates.
#
# Required environment variables:
#   K8_INFISICAL_HOST           — Infisical server URL
#   K8_INFISICAL_PROJECT_ID     — Infisical project UUID
#   K8_INFISICAL_CLIENT_ID      — Universal auth client ID
#   K8_INFISICAL_CLIENT_SECRET  — Universal auth client secret
#
# Optional environment variables (defaults shown):
#   K8_INFISICAL_PROJECT_NAME   — Project display name (for logging)
#   K8_PGBOUNCER_HOST           — PgBouncer service hostname
#   K8_DB_NAME                  — Primary database name
#   K8_DB_USER_PREFIX           — Prefix for database usernames (default: app)
#   K8_ADMIN_EMAIL              — Admin email for services like Directus
# =============================================================================
set -euo pipefail

# -----------------------------------------------------------------------------
# Flags
# -----------------------------------------------------------------------------
DRY_RUN=false
SHOW_SECRETS=false
ENV_ARG=""
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    --show-secrets) SHOW_SECRETS=true ;;
    --env=*) ENV_ARG="${arg#--env=}" ;;
    --help|-h)
      echo "Usage: $(basename "$0") --env=<prod|staging> [--dry-run] [--show-secrets]"
      echo ""
      echo "  --env=ENV       Target environment: prod or staging (required)"
      echo "  --dry-run       Fetch current Infisical values and show which secrets"
      echo "                  would be created or changed. No writes."
      echo "  --show-secrets  Include secret values in output (default: hidden)."
      echo ""
      echo "  Staging mode copies all secrets from prod into the staging environment."
      exit 0
      ;;
  esac
done

ENV_SLUG="${ENV_ARG:-${INFISICAL_ENV:-}}"
if [[ -z "$ENV_SLUG" ]]; then
  echo "❌  No environment specified."
  echo "    Usage: $(basename "$0") --env=prod  or  --env=staging"
  exit 1
fi

if [[ "$ENV_SLUG" != "prod" && "$ENV_SLUG" != "staging" ]]; then
  echo "❌  Unknown environment: $ENV_SLUG (expected: prod or staging)"
  exit 1
fi

if $DRY_RUN; then
  echo "🔍  DRY RUN — no secrets will be written"
  echo ""
fi

# -----------------------------------------------------------------------------
# Config — override via env or edit here
# -----------------------------------------------------------------------------
INFISICAL_HOST="${INFISICAL_HOST:-${K8_INFISICAL_HOST:-}}"
PROJECT_ID="${INFISICAL_PROJECT_ID:-${K8_INFISICAL_PROJECT_ID:-}}"

if [[ -z "$INFISICAL_HOST" ]]; then
  echo "❌  K8_INFISICAL_HOST (or INFISICAL_HOST) is not set."
  exit 1
fi
if [[ -z "$PROJECT_ID" ]]; then
  echo "❌  K8_INFISICAL_PROJECT_ID (or INFISICAL_PROJECT_ID) is not set."
  exit 1
fi

# -----------------------------------------------------------------------------
# Auth — universal auth via API (single login, reuse token for everything)
# -----------------------------------------------------------------------------
EKS_OPERATOR_CLIENT_ID="${EKS_OPERATOR_CLIENT_ID:-${K8_INFISICAL_CLIENT_ID:-}}"
EKS_OPERATOR_CLIENT_SECRET="${EKS_OPERATOR_CLIENT_SECRET:-${K8_INFISICAL_CLIENT_SECRET:-}}"

if [[ -z "$EKS_OPERATOR_CLIENT_ID" ]]; then
  echo "❌  K8_INFISICAL_CLIENT_ID (or EKS_OPERATOR_CLIENT_ID) is not set."
  exit 1
fi
if [[ -z "$EKS_OPERATOR_CLIENT_SECRET" ]]; then
  echo "❌  K8_INFISICAL_CLIENT_SECRET (or EKS_OPERATOR_CLIENT_SECRET) is not set."
  exit 1
fi

echo "🔑  Logging in via universal auth ..."
LOGIN_RESPONSE=$(curl -s -X POST "${INFISICAL_HOST}/api/v1/auth/universal-auth/login" \
  -H "Content-Type: application/json" \
  -d "{\"clientId\":\"${EKS_OPERATOR_CLIENT_ID}\",\"clientSecret\":\"${EKS_OPERATOR_CLIENT_SECRET}\"}")
API_TOKEN=$(echo "$LOGIN_RESPONSE" | grep -o '"accessToken":"[^"]*"' | cut -d'"' -f4)

if [[ -z "$API_TOKEN" ]]; then
  echo "❌  Could not get API token. Check client credentials."
  exit 1
fi

echo "✅  Authenticated with Infisical"
echo "    Host:    $INFISICAL_HOST"
echo "    Project: $PROJECT_ID"
echo "    Env:     $ENV_SLUG"
echo ""

# -----------------------------------------------------------------------------
# Ensure all secret folders exist (create via API, ignore if already present)
# -----------------------------------------------------------------------------
SECRET_FOLDERS=(
  mysqldb
  wordpress
  wordpress-cms
  manticore
  redis
  timescaledb
  pgbouncer
  proxysql
  backend
  frontend
  api
  admin
  donation
  fblogin
  valkey
  infra-valkey
  infra-directus
  infra-posthog
)

ensure_folder() {
  local folder="$1"
  local response
  response=$(curl -s -w "\n%{http_code}" \
    -X POST "${INFISICAL_HOST}/api/v2/folders" \
    -H "Authorization: Bearer ${API_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "{\"projectId\":\"${PROJECT_ID}\",\"environment\":\"${ENV_SLUG}\",\"name\":\"${folder}\",\"path\":\"/\"}" \
    || true)
  local http_code
  http_code=$(echo "$response" | tail -1)
  if [[ "$http_code" == "200" || "$http_code" == "201" ]]; then
    echo "  🆕  /${folder}"
  elif echo "$response" | grep -q "already exists"; then
    echo "  ▪️   /${folder}"
  else
    local body
    body=$(echo "$response" | sed '$d')
    echo "  ❌  /${folder} (HTTP ${http_code})"
  fi
}

if $DRY_RUN; then
  echo "📂  Skipping folder creation (dry run)"
else
  echo "📂  Ensuring secret folders ..."
  batch=0
  for folder in "${SECRET_FOLDERS[@]}"; do
    ensure_folder "$folder" &
    batch=$((batch+1))
    if (( batch % 4 == 0 )); then
      wait
    fi
  done
  wait
fi
echo ""

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
generate_password() {
  local name="${1:-_NOT_PROVIDED_}"
  local pw
  pw=$(openssl rand -base64 32 | tr -d '=+/' | cut -c1-32)
  if ! $DRY_RUN && $SHOW_SECRETS; then
    echo "export ${name}=${pw}" >> .envrc.secrets
  fi
  echo "$pw"
}

generate_hex() {
  openssl rand -hex 32
}

get_secret() {
  local path="$1"
  local key="$2"
  local response
  response=$(curl -s \
    -X GET "${INFISICAL_HOST}/api/v3/secrets/raw/${key}?workspaceId=${PROJECT_ID}&environment=${ENV_SLUG}&secretPath=${path}" \
    -H "Authorization: Bearer ${API_TOKEN}")
  # Extract value — returns empty string if secret doesn't exist
  echo "$response" | grep -o '"secretValue":"[^"]*"' | cut -d'"' -f4 || true
}

set_secret() {
  local path="$1"
  local key="$2"
  local value="$3"

  if $DRY_RUN; then
    local current
    current=$(get_secret "$path" "$key")
    if [[ -z "$current" ]]; then
      echo "  🆕  ${path}/${key}"
    elif [[ "$current" == "$value" ]]; then
      echo "  ▪️   ${path}/${key}"
    else
      echo "  ✅  ${path}/${key}"
    fi
    return
  fi

  # Check current value, then create or update as needed
  local current
  current=$(get_secret "$path" "$key")

  local http_code
  if [[ -z "$current" ]]; then
    http_code=$(curl -s -o /dev/null -w "%{http_code}" \
      -X POST "${INFISICAL_HOST}/api/v3/secrets/raw/${key}" \
      -H "Authorization: Bearer ${API_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "{\"workspaceId\":\"${PROJECT_ID}\",\"environment\":\"${ENV_SLUG}\",\"secretPath\":\"${path}\",\"secretValue\":\"${value}\",\"type\":\"shared\"}")
    if [[ "$http_code" == "200" || "$http_code" == "201" ]]; then
      echo "  🆕  ${path}/${key}"
    else
      echo "  ❌  ${path}/${key} (HTTP ${http_code})"
    fi
  elif [[ "$current" == "$value" ]]; then
    echo "  ▪️   ${path}/${key}"
  else
    http_code=$(curl -s -o /dev/null -w "%{http_code}" \
      -X PATCH "${INFISICAL_HOST}/api/v3/secrets/raw/${key}" \
      -H "Authorization: Bearer ${API_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "{\"workspaceId\":\"${PROJECT_ID}\",\"environment\":\"${ENV_SLUG}\",\"secretPath\":\"${path}\",\"secretValue\":\"${value}\",\"type\":\"shared\"}")
    if [[ "$http_code" == "200" ]]; then
      echo "  ✅  ${path}/${key}"
    else
      echo "  ❌  ${path}/${key} (HTTP ${http_code})"
    fi
  fi
}

# =============================================================================
# STAGING: copy all secrets from prod → staging, then exit
# =============================================================================

if [[ "$ENV_SLUG" == "staging" ]]; then
  echo "📋  Copying all secrets from prod → staging ..."
  echo ""

  get_prod_secret() {
    local path="$1"
    local key="$2"
    local response
    response=$(curl -s \
      -X GET "${INFISICAL_HOST}/api/v3/secrets/raw/${key}?workspaceId=${PROJECT_ID}&environment=prod&secretPath=${path}" \
      -H "Authorization: Bearer ${API_TOKEN}")
    echo "$response" | grep -o '"secretValue":"[^"]*"' | cut -d'"' -f4 || true
  }

  list_prod_keys() {
    local path="$1"
    curl -s \
      -X GET "${INFISICAL_HOST}/api/v3/secrets/raw?workspaceId=${PROJECT_ID}&environment=prod&secretPath=${path}&recursive=false" \
      -H "Authorization: Bearer ${API_TOKEN}" \
    | grep -o '"secretKey":"[^"]*"' | cut -d'"' -f4
  }

  copy_folder() {
    local folder="$1"
    local keys
    keys=$(list_prod_keys "/${folder}")

    if [[ -z "$keys" ]]; then
      echo "  ⚠️   /${folder} — no secrets in prod"
      return
    fi

    echo "  📁  /${folder}"
    while IFS= read -r key; do
      local val
      val=$(get_prod_secret "/${folder}" "$key")
      if [[ -n "$val" ]]; then
        set_secret "/${folder}" "$key" "$val"
      fi
    done <<< "$keys"
  }

  for folder in "${SECRET_FOLDERS[@]}"; do
    copy_folder "$folder"
  done

  echo ""
  echo "=============================================="
  echo "✅  Done! Copied prod secrets → staging"
  echo ""
  echo "  Verify with:"
  echo "    infisical secrets list --projectId $PROJECT_ID --env staging --path /backend --domain $INFISICAL_HOST"
  echo "=============================================="
  exit 0
fi

# =============================================================================
# PROD: Resolve all secret values — env var overrides or auto-generate
# =============================================================================

# --- /mysqldb ---
MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD:-$(generate_password MYSQL_ROOT_PASSWORD)}
APP_DB_PASSWORD=${APP_DB_PASSWORD:-$(generate_password APP_DB_PASSWORD)}
APP_WORDPRESS_DB_PASSWORD=${APP_WORDPRESS_DB_PASSWORD:-$(generate_password APP_WORDPRESS_DB_PASSWORD)}
CMS_PAGES_APP_DB_PASSWORD=${CMS_PAGES_APP_DB_PASSWORD:-$(generate_password CMS_PAGES_APP_DB_PASSWORD)}
LEGACY_APP_DB_PASSWORD=${LEGACY_APP_DB_PASSWORD:-$(generate_password LEGACY_APP_DB_PASSWORD)}
OTEL_MONITOR_MYSQL_PASSWORD=${OTEL_MONITOR_MYSQL_PASSWORD:-$(generate_password OTEL_MONITOR_MYSQL_PASSWORD)}

# --- reporting (shared across MySQL + TimescaleDB) ---
REPORTING_DB_PASSWORD=${REPORTING_DB_PASSWORD:-$(generate_password REPORTING_DB_PASSWORD)}

# --- /wordpress (EKS MySQL) ---
WP_AUTH_KEY=${WP_AUTH_KEY:-$(generate_hex)}
WP_SECURE_AUTH_KEY=${WP_SECURE_AUTH_KEY:-$(generate_hex)}
WP_LOGGED_IN_KEY=${WP_LOGGED_IN_KEY:-$(generate_hex)}
WP_NONCE_KEY=${WP_NONCE_KEY:-$(generate_hex)}
WP_AUTH_SALT=${WP_AUTH_SALT:-$(generate_hex)}
WP_SECURE_AUTH_SALT=${WP_SECURE_AUTH_SALT:-$(generate_hex)}
WP_LOGGED_IN_SALT=${WP_LOGGED_IN_SALT:-$(generate_hex)}
WP_NONCE_SALT=${WP_NONCE_SALT:-$(generate_hex)}
EC2_WP_AUTH_KEY=${EC2_WP_AUTH_KEY:-}
EC2_WP_SECURE_AUTH_KEY=${EC2_WP_SECURE_AUTH_KEY:-}
EC2_WP_LOGGED_IN_KEY=${EC2_WP_LOGGED_IN_KEY:-}
EC2_WP_NONCE_KEY=${EC2_WP_NONCE_KEY:-}
EC2_WP_AUTH_SALT=${EC2_WP_AUTH_SALT:-}
EC2_WP_SECURE_AUTH_SALT=${EC2_WP_SECURE_AUTH_SALT:-}
EC2_WP_LOGGED_IN_SALT=${EC2_WP_LOGGED_IN_SALT:-}
EC2_WP_NONCE_SALT=${EC2_WP_NONCE_SALT:-}

# --- /wordpress-cms ---
CMS_DB_PASSWORD=${CMS_DB_PASSWORD:-$CMS_PAGES_APP_DB_PASSWORD}
CMS_AUTH_KEY=${CMS_AUTH_KEY:-$(generate_hex)}
CMS_SECURE_AUTH_KEY=${CMS_SECURE_AUTH_KEY:-$(generate_hex)}
CMS_LOGGED_IN_KEY=${CMS_LOGGED_IN_KEY:-$(generate_hex)}
CMS_NONCE_KEY=${CMS_NONCE_KEY:-$(generate_hex)}
CMS_AUTH_SALT=${CMS_AUTH_SALT:-$(generate_hex)}
CMS_SECURE_AUTH_SALT=${CMS_SECURE_AUTH_SALT:-$(generate_hex)}
CMS_LOGGED_IN_SALT=${CMS_LOGGED_IN_SALT:-$(generate_hex)}
CMS_NONCE_SALT=${CMS_NONCE_SALT:-$(generate_hex)}

# --- /manticore ---
PGSQL_HOST=${PGSQL_HOST:-${K8_PGBOUNCER_HOST:-pgbouncer.default.svc.cluster.local}}
PGSQL_PORT=${PGSQL_PORT:-6432}
PGSQL_USER=${PGSQL_USER:-${K8_DB_USER_PREFIX:-app}_manticore}
PGSQL_DB=${PGSQL_DB:-${K8_DB_NAME:-}}
# NOTE: PGSQL_PASS default set after APP_MANTICORE_DB_PASSWORD is defined below

# --- /redis (per-ACL-user passwords) ---
DEFAULT_APP_REDIS_PASSWORD=${DEFAULT_APP_REDIS_PASSWORD:-$(generate_password DEFAULT_APP_REDIS_PASSWORD)}
APP_BACKEND_REDIS_PASSWORD=${APP_BACKEND_REDIS_PASSWORD:-$(generate_password APP_BACKEND_REDIS_PASSWORD)}
APP_FRONTEND_REDIS_PASSWORD=${APP_FRONTEND_REDIS_PASSWORD:-$(generate_password APP_FRONTEND_REDIS_PASSWORD)}
APP_WORDPRESS_REDIS_PASSWORD=${APP_WORDPRESS_REDIS_PASSWORD:-$(generate_password APP_WORDPRESS_REDIS_PASSWORD)}
WORDPRESS_CMS_REDIS_PASSWORD=${WORDPRESS_CMS_REDIS_PASSWORD:-$(generate_password WORDPRESS_CMS_REDIS_PASSWORD)}
OTEL_MONITOR_REDIS_PASSWORD=${OTEL_MONITOR_REDIS_PASSWORD:-$(generate_password OTEL_MONITOR_REDIS_PASSWORD)}

# --- /timescaledb ---
TIMESCALE_POSTGRES_PASSWORD=${TIMESCALE_POSTGRES_PASSWORD:-$(generate_password TIMESCALE_POSTGRES_PASSWORD)}
# REPLICATION_PASSWORD must match the EC2 primary's replicator password,
# because the EKS standby inherits pg_authid via base backup / WAL replay.
TIMESCALE_REPLICATION_PASSWORD=${EC2_REPLICATION_PASSWORD:-${TIMESCALE_REPLICATION_PASSWORD:-$(generate_password TIMESCALE_REPLICATION_PASSWORD)}}
APP_BACKEND_DB_PASSWORD=${APP_BACKEND_DB_PASSWORD:-$(generate_password APP_BACKEND_DB_PASSWORD)}
APP_BACKEND_READ_DB_PASSWORD=${APP_BACKEND_READ_DB_PASSWORD:-$(generate_password APP_BACKEND_READ_DB_PASSWORD)}
APP_FRONTEND_DB_PASSWORD=${APP_FRONTEND_DB_PASSWORD:-$(generate_password APP_FRONTEND_DB_PASSWORD)}
APP_MANTICORE_DB_PASSWORD=${APP_MANTICORE_DB_PASSWORD:-$(generate_password APP_MANTICORE_DB_PASSWORD)}
OTEL_MONITOR_DB_PASSWORD=${OTEL_MONITOR_DB_PASSWORD:-$(generate_password OTEL_MONITOR_DB_PASSWORD)}
APP_MIGRATE_DB_PASSWORD=${APP_MIGRATE_DB_PASSWORD:-$(generate_password APP_MIGRATE_DB_PASSWORD)}
DIRECTUS_TSDB_PASSWORD=${DIRECTUS_TSDB_PASSWORD:-$DIRECTUS_DB_PASSWORD}

# Deferred: depends on APP_MANTICORE_DB_PASSWORD above
PGSQL_PASS=${PGSQL_PASS:-$APP_MANTICORE_DB_PASSWORD}

# --- /proxysql (admin + backend DB password) ---
PROXYSQL_ADMIN_PASSWORD=${PROXYSQL_ADMIN_PASSWORD:-$(generate_password PROXYSQL_ADMIN_PASSWORD)}
# PGSQL_USER_APP_BACKEND_PASSWORD shares the same value as APP_BACKEND_DB_PASSWORD
PGSQL_USER_APP_BACKEND_PASSWORD=${PGSQL_USER_APP_BACKEND_PASSWORD:-$APP_BACKEND_DB_PASSWORD}

# --- /pgbouncer ---
# pgbouncer (primary) is a TEMP PATCH still pointing at the EC2 instance.
# pgbouncer-readonly points at timescaledb-replica; it shares these
# credentials because the replica inherits pg_shadow via WAL streaming.
EC2_DB_USER=${EC2_DB_USER:-}
EC2_DB_PASSWORD=${EC2_DB_PASSWORD:-}
# app_pgbouncer — dedicated auth_user for both pgbouncers (no superuser).
# Run utils/pgbouncer-auth-setup.sql on the primary before deploying.
APP_PGBOUNCER_PASSWORD=${APP_PGBOUNCER_PASSWORD:-$(generate_password APP_PGBOUNCER_PASSWORD)}

# --- /timescaledb standby (EC2 replication password for migration) ---
EC2_REPLICATION_PASSWORD=${EC2_REPLICATION_PASSWORD:-}

# --- /backend ---
DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY:-$(python3 -c "
import secrets, string
chars = string.ascii_letters + string.digits + '!@#\$%^&*(-_=+)'
print(''.join(secrets.choice(chars) for _ in range(50)))
" 2>/dev/null || generate_hex)}
# DB_PASSWORD now comes from APP_BACKEND_DB_PASSWORD (dedicated TimescaleDB user)
BACKEND_DB_PASSWORD=${BACKEND_DB_PASSWORD:-$APP_BACKEND_DB_PASSWORD}
BACKEND_READ_DB_PASSWORD=${BACKEND_READ_DB_PASSWORD:-$APP_BACKEND_READ_DB_PASSWORD}
SENDGRID_API_KEY=${SENDGRID_API_KEY:-}
EMAIL_HOST_USER=${EMAIL_HOST_USER:-}
EMAIL_HOST_PASSWORD=${EMAIL_HOST_PASSWORD:-}
PPGF_CLIENT_ID=${PPGF_CLIENT_ID:-}
PPGF_SECRET=${PPGF_SECRET:-}
PPGF_PAYEE_MERCHANT_ID=${PPGF_PAYEE_MERCHANT_ID:-}
PPGF_TIP_PAYEE_MERCHANT_ID=${PPGF_TIP_PAYEE_MERCHANT_ID:-}
GRAPHICMAILAPI_LOGIN=${GRAPHICMAILAPI_LOGIN:-}
GRAPHICMAILAPI_PASSWORD=${GRAPHICMAILAPI_PASSWORD:-}

# --- /admin (SSH key for EC2 rsync/migration) ---
EC2_USER_RSA_KEY=${EC2_USER_RSA_KEY:-}

# --- /api (legacy PHP app — MySQL password for app_web user) ---
APP_API_MYSQL_PASSWORD=${APP_API_MYSQL_PASSWORD:-$APP_DB_PASSWORD}

# --- /frontend (only DB_PASSWORD is loaded via secretKeyRef) ---
FRONTEND_DB_PASSWORD=${FRONTEND_DB_PASSWORD:-$APP_FRONTEND_DB_PASSWORD}

# --- /donation (Stripe + SendGrid) ---
APP_DONATE_STRIPE_SECRET_KEY=${APP_DONATE_STRIPE_SECRET_KEY:-}
APP_DONATE_SENDGRID_API_KEY=${APP_DONATE_SENDGRID_API_KEY:-}

# --- /fblogin (Facebook OAuth login) ---
FB_APP_ID=${FB_APP_ID:-}
FB_APP_SECRET=${FB_APP_SECRET:-}
FB_GRAPH_VERSION=${FB_GRAPH_VERSION:-v21.0}
APP_ENCRYPT_KEY=${APP_ENCRYPT_KEY:-$(generate_hex)}

# --- /infra-directus (Directus CMS) ---
DIRECTUS_SECRET=${DIRECTUS_SECRET:-$(generate_hex)}
DIRECTUS_DB_PASSWORD=${DIRECTUS_DB_PASSWORD:-$(generate_password DIRECTUS_DB_PASSWORD)}
DIRECTUS_ADMIN_EMAIL=${DIRECTUS_ADMIN_EMAIL:-${K8_ADMIN_EMAIL:-admin@example.com}}
DIRECTUS_ADMIN_PASSWORD=${DIRECTUS_ADMIN_PASSWORD:-$(generate_password DIRECTUS_ADMIN_PASSWORD)}
DIRECTUS_REDIS_PASSWORD=${DIRECTUS_REDIS_PASSWORD:-$(generate_password DIRECTUS_REDIS_PASSWORD)}

# --- /infra-posthog (PostHog product analytics) ---
POSTHOG_SECRET_KEY=${POSTHOG_SECRET_KEY:-$(generate_hex)}
POSTHOG_DB_PASSWORD=${POSTHOG_DB_PASSWORD:-$(generate_password POSTHOG_DB_PASSWORD)}
POSTHOG_REDIS_PASSWORD=${POSTHOG_REDIS_PASSWORD:-$(generate_password POSTHOG_REDIS_PASSWORD)}

# --- /infra-valkey (per-ACL-user passwords, infra namespace) ---
DEFAULT_INFRA_REDIS_PASSWORD=${DEFAULT_INFRA_REDIS_PASSWORD:-$(generate_password DEFAULT_INFRA_REDIS_PASSWORD)}
INFISICAL_REDIS_PASSWORD=${INFISICAL_REDIS_PASSWORD:-$(generate_password INFISICAL_REDIS_PASSWORD)}

# =============================================================================
# /mysqldb
# =============================================================================

set_secret "/mysqldb" "MYSQL_ROOT_PASSWORD"        "$MYSQL_ROOT_PASSWORD" &
set_secret "/mysqldb" "APP_DB_PASSWORD"            "$APP_DB_PASSWORD" &
set_secret "/mysqldb" "APP_WORDPRESS_DB_PASSWORD"  "$APP_WORDPRESS_DB_PASSWORD" &
set_secret "/mysqldb" "CMS_PAGES_APP_DB_PASSWORD"  "$CMS_PAGES_APP_DB_PASSWORD" &
set_secret "/mysqldb" "LEGACY_APP_DB_PASSWORD"  "$LEGACY_APP_DB_PASSWORD" &
set_secret "/mysqldb" "REPORTING_DB_PASSWORD"   "$REPORTING_DB_PASSWORD" &
set_secret "/mysqldb" "OTEL_MONITOR_MYSQL_PASSWORD" "$OTEL_MONITOR_MYSQL_PASSWORD" &

# =============================================================================
# /wordpress
# =============================================================================

set_secret "/wordpress" "DB_PASSWORD"       "$APP_WORDPRESS_DB_PASSWORD" &
set_secret "/wordpress" "AUTH_KEY"          "$WP_AUTH_KEY" &
set_secret "/wordpress" "SECURE_AUTH_KEY"   "$WP_SECURE_AUTH_KEY" &
set_secret "/wordpress" "LOGGED_IN_KEY"     "$WP_LOGGED_IN_KEY" &
set_secret "/wordpress" "NONCE_KEY"         "$WP_NONCE_KEY" &
set_secret "/wordpress" "AUTH_SALT"         "$WP_AUTH_SALT" &
set_secret "/wordpress" "SECURE_AUTH_SALT"  "$WP_SECURE_AUTH_SALT" &
set_secret "/wordpress" "LOGGED_IN_SALT"    "$WP_LOGGED_IN_SALT" &
set_secret "/wordpress" "NONCE_SALT"        "$WP_NONCE_SALT" &

# --- EC2 transitional secrets (archived, no longer used by deployment) ---
if [[ -n "$EC2_WP_DB_PASSWORD" ]]; then
  set_secret "/wordpress" "EC2_WP_DB_PASSWORD"    "$EC2_WP_DB_PASSWORD" &
  set_secret "/wordpress" "EC2_AUTH_KEY"          "$EC2_WP_AUTH_KEY" &
  set_secret "/wordpress" "EC2_SECURE_AUTH_KEY"   "$EC2_WP_SECURE_AUTH_KEY" &
  set_secret "/wordpress" "EC2_LOGGED_IN_KEY"     "$EC2_WP_LOGGED_IN_KEY" &
  set_secret "/wordpress" "EC2_NONCE_KEY"         "$EC2_WP_NONCE_KEY" &
  set_secret "/wordpress" "EC2_AUTH_SALT"         "$EC2_WP_AUTH_SALT" &
  set_secret "/wordpress" "EC2_SECURE_AUTH_SALT"  "$EC2_WP_SECURE_AUTH_SALT" &
  set_secret "/wordpress" "EC2_LOGGED_IN_SALT"    "$EC2_WP_LOGGED_IN_SALT" &
  set_secret "/wordpress" "EC2_NONCE_SALT"        "$EC2_WP_NONCE_SALT" &
else
  echo "  ⚠️   EC2_WP_DB_PASSWORD not set — provide EC2 wp-config.php secrets via:"
  echo "       export EC2_WP_DB_PASSWORD=<value>"
  echo "       export EC2_WP_AUTH_KEY=<value>  (and all 8 salt/key vars)"
fi

# =============================================================================
# /wordpress-cms
# =============================================================================

set_secret "/wordpress-cms" "DB_PASSWORD"       "$CMS_DB_PASSWORD" &
set_secret "/wordpress-cms" "AUTH_KEY"          "$CMS_AUTH_KEY" &
set_secret "/wordpress-cms" "SECURE_AUTH_KEY"   "$CMS_SECURE_AUTH_KEY" &
set_secret "/wordpress-cms" "LOGGED_IN_KEY"     "$CMS_LOGGED_IN_KEY" &
set_secret "/wordpress-cms" "NONCE_KEY"         "$CMS_NONCE_KEY" &
set_secret "/wordpress-cms" "AUTH_SALT"         "$CMS_AUTH_SALT" &
set_secret "/wordpress-cms" "SECURE_AUTH_SALT"  "$CMS_SECURE_AUTH_SALT" &
set_secret "/wordpress-cms" "LOGGED_IN_SALT"    "$CMS_LOGGED_IN_SALT" &
set_secret "/wordpress-cms" "NONCE_SALT"        "$CMS_NONCE_SALT" &

# =============================================================================
# /manticore
# =============================================================================

set_secret "/manticore" "PGSQL_HOST" "$PGSQL_HOST" &
set_secret "/manticore" "PGSQL_PORT" "$PGSQL_PORT" &
set_secret "/manticore" "PGSQL_USER" "$PGSQL_USER" &
set_secret "/manticore" "PGSQL_DB"   "$PGSQL_DB" &

set_secret "/manticore" "PGSQL_PASS" "$PGSQL_PASS" &

# =============================================================================
# /redis (per-ACL-user passwords)
# =============================================================================

set_secret "/redis" "DEFAULT_APP_REDIS_PASSWORD" "$DEFAULT_APP_REDIS_PASSWORD" &
set_secret "/redis" "APP_BACKEND_PASSWORD"       "$APP_BACKEND_REDIS_PASSWORD" &
set_secret "/redis" "APP_FRONTEND_PASSWORD"      "$APP_FRONTEND_REDIS_PASSWORD" &
set_secret "/redis" "APP_WORDPRESS_PASSWORD"     "$APP_WORDPRESS_REDIS_PASSWORD" &
set_secret "/redis" "WORDPRESS_CMS_PASSWORD"     "$WORDPRESS_CMS_REDIS_PASSWORD" &
set_secret "/redis" "OTEL_MONITOR_REDIS_PASSWORD" "$OTEL_MONITOR_REDIS_PASSWORD" &

# =============================================================================
# /valkey (drop-in replacement for redis, same passwords, new folder)
# =============================================================================

set_secret "/valkey" "DEFAULT_APP_REDIS_PASSWORD" "$DEFAULT_APP_REDIS_PASSWORD" &
set_secret "/valkey" "APP_BACKEND_PASSWORD"       "$APP_BACKEND_REDIS_PASSWORD" &
set_secret "/valkey" "APP_FRONTEND_PASSWORD"      "$APP_FRONTEND_REDIS_PASSWORD" &

# =============================================================================
# /timescaledb
# =============================================================================

set_secret "/timescaledb" "POSTGRES_PASSWORD"        "$TIMESCALE_POSTGRES_PASSWORD" &
set_secret "/timescaledb" "REPLICATION_PASSWORD"     "$TIMESCALE_REPLICATION_PASSWORD" &
set_secret "/timescaledb" "APP_BACKEND_DB_PASSWORD"      "$APP_BACKEND_DB_PASSWORD" &
set_secret "/timescaledb" "APP_BACKEND_READ_DB_PASSWORD" "$APP_BACKEND_READ_DB_PASSWORD" &
set_secret "/timescaledb" "APP_FRONTEND_DB_PASSWORD"     "$APP_FRONTEND_DB_PASSWORD" &
set_secret "/timescaledb" "APP_MANTICORE_DB_PASSWORD" "$APP_MANTICORE_DB_PASSWORD" &
set_secret "/timescaledb" "REPORTING_DB_PASSWORD"     "$REPORTING_DB_PASSWORD" &
set_secret "/timescaledb" "OTEL_MONITOR_DB_PASSWORD"  "$OTEL_MONITOR_DB_PASSWORD" &
set_secret "/timescaledb" "APP_MIGRATE_DB_PASSWORD"  "$APP_MIGRATE_DB_PASSWORD" &
set_secret "/timescaledb" "DIRECTUS_DB_PASSWORD"    "$DIRECTUS_TSDB_PASSWORD" &

if [[ -n "$EC2_REPLICATION_PASSWORD" ]]; then
  set_secret "/timescaledb" "EC2_REPLICATION_PASSWORD" "$EC2_REPLICATION_PASSWORD" &
fi

# =============================================================================
# /pgbouncer
# Shared by pgbouncer (primary, TEMP PATCH → EC2) and pgbouncer-readonly
# (→ timescaledb-replica). Both use EC2 credentials; the replica inherits
# pg_shadow from the primary via WAL streaming so auth works transparently.
# =============================================================================

if [[ -n "$EC2_DB_USER" && -n "$EC2_DB_PASSWORD" ]]; then
  set_secret "/pgbouncer" "EC2_DB_USER"     "$EC2_DB_USER" &
  set_secret "/pgbouncer" "EC2_DB_PASSWORD"  "$EC2_DB_PASSWORD" &
else
  echo "  ⚠️   EC2_DB_USER / EC2_DB_PASSWORD not set — provide via:"
  echo "       export EC2_DB_USER=<value>"
  echo "       export EC2_DB_PASSWORD=<value>"
fi

set_secret "/pgbouncer" "APP_PGBOUNCER_PASSWORD" "$APP_PGBOUNCER_PASSWORD" &

# =============================================================================
# /proxysql
# =============================================================================

set_secret "/proxysql" "PROXYSQL_ADMIN_PASSWORD"           "$PROXYSQL_ADMIN_PASSWORD" &
set_secret "/proxysql" "PGSQL_USER_APP_BACKEND_PASSWORD"   "$PGSQL_USER_APP_BACKEND_PASSWORD" &

# =============================================================================
# /backend
# =============================================================================

set_secret "/backend" "DJANGO_SECRET_KEY" "$DJANGO_SECRET_KEY" &

if [[ -n "$BACKEND_DB_PASSWORD" ]]; then
  set_secret "/backend" "DB_PASSWORD" "$BACKEND_DB_PASSWORD" &
else
  echo "  ⚠️   DB_PASSWORD not set — provide via: export APP_BACKEND_DB_PASSWORD=<value> or export BACKEND_DB_PASSWORD=<value>"
fi

if [[ -n "$BACKEND_READ_DB_PASSWORD" ]]; then
  set_secret "/backend" "DB_REPLICA_PASSWORD" "$BACKEND_READ_DB_PASSWORD" &
else
  echo "  ⚠️   DB_REPLICA_PASSWORD not set — provide via: export APP_BACKEND_READ_DB_PASSWORD=<value>"
fi

MISSING=()
for var in SENDGRID_API_KEY EMAIL_HOST_USER EMAIL_HOST_PASSWORD \
           PPGF_CLIENT_ID PPGF_SECRET PPGF_PAYEE_MERCHANT_ID \
           PPGF_TIP_PAYEE_MERCHANT_ID GRAPHICMAILAPI_LOGIN GRAPHICMAILAPI_PASSWORD; do
  if [[ -n "${!var:-}" ]]; then
    set_secret "/backend" "$var" "${!var}" &
  else
    MISSING+=("$var")
  fi
done

if [[ ${#MISSING[@]} -gt 0 ]]; then
  echo ""
  echo "  ⚠️   The following backend secrets were skipped (not in env):"
  for var in "${MISSING[@]}"; do
    echo "       export $var=<value>"
  done
fi

# =============================================================================
# /admin (SSH key for EC2 rsync/migration)
# =============================================================================

if [[ -n "$EC2_USER_RSA_KEY" ]]; then
  set_secret "/admin" "EC2_USER_RSA_KEY" "$EC2_USER_RSA_KEY" &
else
  echo "  ⚠️   EC2_USER_RSA_KEY not set — provide base64-encoded SSH private key via:"
  echo "       export EC2_USER_RSA_KEY=\$(base64 < ~/.ssh/id_rsa)"
fi

# =============================================================================
# /api (legacy PHP API — MySQL password for app_web user)
# =============================================================================

set_secret "/api" "MYSQL_PASSWORD" "$APP_API_MYSQL_PASSWORD" &

# =============================================================================
# /frontend
# =============================================================================

set_secret "/frontend" "DB_PASSWORD" "$FRONTEND_DB_PASSWORD" &

# =============================================================================
# /infra-valkey (per-ACL-user passwords, infra namespace)
# =============================================================================

# =============================================================================
# /donation (Stripe + SendGrid)
# =============================================================================

set_secret "/donation" "APP_DONATE_STRIPE_SECRET_KEY" "$APP_DONATE_STRIPE_SECRET_KEY" &
set_secret "/donation" "APP_DONATE_SENDGRID_API_KEY"  "$APP_DONATE_SENDGRID_API_KEY" &

# =============================================================================
# /fblogin (Facebook OAuth login)
# =============================================================================

FBLOGIN_MISSING=()
for var in FB_APP_ID FB_APP_SECRET; do
  if [[ -n "${!var:-}" ]]; then
    set_secret "/fblogin" "$var" "${!var}" &
  else
    FBLOGIN_MISSING+=("$var")
  fi
done

set_secret "/fblogin" "FB_GRAPH_VERSION" "$FB_GRAPH_VERSION" &
set_secret "/fblogin" "APP_ENCRYPT_KEY"  "$APP_ENCRYPT_KEY" &

if [[ ${#FBLOGIN_MISSING[@]} -gt 0 ]]; then
  echo ""
  echo "  ⚠️   The following fblogin secrets were skipped (not in env):"
  for var in "${FBLOGIN_MISSING[@]}"; do
    echo "       export $var=<value>"
  done
fi

# =============================================================================
# /infra-directus (Directus CMS — PostgreSQL password + app secret)
# =============================================================================

set_secret "/infra-directus" "DIRECTUS_SECRET"         "$DIRECTUS_SECRET" &
set_secret "/infra-directus" "DB_PASSWORD"              "$DIRECTUS_DB_PASSWORD" &
set_secret "/infra-directus" "ADMIN_EMAIL"              "$DIRECTUS_ADMIN_EMAIL" &
set_secret "/infra-directus" "ADMIN_PASSWORD"           "$DIRECTUS_ADMIN_PASSWORD" &
set_secret "/infra-directus" "DIRECTUS_REDIS_PASSWORD"  "$DIRECTUS_REDIS_PASSWORD" &
set_secret "/infra-directus" "DIRECTUS_REDIS_USER"      "directus" &

# =============================================================================
# /infra-posthog (PostHog — secret key, DB password, Redis password)
# =============================================================================

set_secret "/infra-posthog" "POSTHOG_SECRET_KEY"      "$POSTHOG_SECRET_KEY" &
set_secret "/infra-posthog" "DB_PASSWORD"              "$POSTHOG_DB_PASSWORD" &
set_secret "/infra-posthog" "POSTHOG_REDIS_PASSWORD"   "$POSTHOG_REDIS_PASSWORD" &

set_secret "/infra-valkey" "DEFAULT_INFRA_REDIS_PASSWORD" "$DEFAULT_INFRA_REDIS_PASSWORD" &
set_secret "/infra-valkey" "INFISICAL_PASSWORD"           "$INFISICAL_REDIS_PASSWORD" &
set_secret "/infra-valkey" "DIRECTUS_PASSWORD"            "$DIRECTUS_REDIS_PASSWORD" &
set_secret "/infra-valkey" "POSTHOG_PASSWORD"             "$POSTHOG_REDIS_PASSWORD" &

# Wait for all background set_secret jobs to finish
wait
echo ""

