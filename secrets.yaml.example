# =============================================================================
# Secret Topology Configuration for infisical-populate-secrets
# Copy to secrets.yaml and customize for your infrastructure.
# =============================================================================
#
# Variable source types (shorthand string):
#   generate:password     — random 32-char alphanumeric
#   generate:hex          — random 64-char hex string
#   generate:django       — Django-style secret key (50 chars, mixed)
#   inherit:VAR_NAME      — copy value from another resolved variable
#   default:VALUE         — static default value
#   optional              — env-only, no generation, skip if empty
#
# Variable source types (expanded object):
#   env: ENV_VAR          — read from a differently-named env var
#   default: VALUE        — fallback if env is empty
#   generate: TYPE        — generate if env is empty (password, hex, django)
#   eval: "EXPRESSION"    — bash expression with env var expansion
#   required: false       — equivalent to 'optional'
#
# All variables can be overridden by an env var matching the variable name.
# The source spec defines what happens when the env var is NOT set.
#
# Mapping flags (prefix on variable reference):
#   VAR_NAME              — always set (even if empty string)
#   ?VAR_NAME             — optional: skip silently if value is empty
# =============================================================================

folders:
  - mysqldb
  - wordpress
  - wordpress-cms
  - manticore
  - redis
  - timescaledb
  - pgbouncer
  - proxysql
  - backend
  - frontend
  - api
  - admin
  - donation
  - fblogin
  - valkey
  - infra-valkey
  - infra-directus
  - infra-posthog

variables:
  # ---------------------------------------------------------------------------
  # MySQL
  # ---------------------------------------------------------------------------
  MYSQL_ROOT_PASSWORD: generate:password
  APP_DB_PASSWORD: generate:password
  APP_WORDPRESS_DB_PASSWORD: generate:password
  CMS_PAGES_APP_DB_PASSWORD: generate:password
  LEGACY_APP_DB_PASSWORD: generate:password
  OTEL_MONITOR_MYSQL_PASSWORD: generate:password

  # ---------------------------------------------------------------------------
  # Shared across MySQL + TimescaleDB
  # ---------------------------------------------------------------------------
  REPORTING_DB_PASSWORD: generate:password

  # ---------------------------------------------------------------------------
  # WordPress (EKS — auto-generated salts/keys)
  # ---------------------------------------------------------------------------
  WP_AUTH_KEY: generate:hex
  WP_SECURE_AUTH_KEY: generate:hex
  WP_LOGGED_IN_KEY: generate:hex
  WP_NONCE_KEY: generate:hex
  WP_AUTH_SALT: generate:hex
  WP_SECURE_AUTH_SALT: generate:hex
  WP_LOGGED_IN_SALT: generate:hex
  WP_NONCE_SALT: generate:hex

  # ---------------------------------------------------------------------------
  # WordPress EC2 transitional (provide all 9 via env, or omit entirely)
  # ---------------------------------------------------------------------------
  EC2_WP_DB_PASSWORD: optional
  EC2_WP_AUTH_KEY: optional
  EC2_WP_SECURE_AUTH_KEY: optional
  EC2_WP_LOGGED_IN_KEY: optional
  EC2_WP_NONCE_KEY: optional
  EC2_WP_AUTH_SALT: optional
  EC2_WP_SECURE_AUTH_SALT: optional
  EC2_WP_LOGGED_IN_SALT: optional
  EC2_WP_NONCE_SALT: optional

  # ---------------------------------------------------------------------------
  # WordPress CMS
  # ---------------------------------------------------------------------------
  CMS_DB_PASSWORD: inherit:CMS_PAGES_APP_DB_PASSWORD
  CMS_AUTH_KEY: generate:hex
  CMS_SECURE_AUTH_KEY: generate:hex
  CMS_LOGGED_IN_KEY: generate:hex
  CMS_NONCE_KEY: generate:hex
  CMS_AUTH_SALT: generate:hex
  CMS_SECURE_AUTH_SALT: generate:hex
  CMS_LOGGED_IN_SALT: generate:hex
  CMS_NONCE_SALT: generate:hex

  # ---------------------------------------------------------------------------
  # Manticore (PostgreSQL connection via PgBouncer)
  # ---------------------------------------------------------------------------
  PGSQL_HOST:
    env: K8_PGBOUNCER_HOST
    default: "pgbouncer.default.svc.cluster.local"
  PGSQL_PORT:
    default: "6432"
  PGSQL_USER:
    eval: "${K8_DB_USER_PREFIX:-app}_manticore"
  PGSQL_DB:
    env: K8_DB_NAME

  # ---------------------------------------------------------------------------
  # Redis (per-ACL-user passwords)
  # ---------------------------------------------------------------------------
  DEFAULT_APP_REDIS_PASSWORD: generate:password
  APP_BACKEND_REDIS_PASSWORD: generate:password
  APP_FRONTEND_REDIS_PASSWORD: generate:password
  APP_WORDPRESS_REDIS_PASSWORD: generate:password
  WORDPRESS_CMS_REDIS_PASSWORD: generate:password
  OTEL_MONITOR_REDIS_PASSWORD: generate:password

  # ---------------------------------------------------------------------------
  # TimescaleDB
  # ---------------------------------------------------------------------------
  TIMESCALE_POSTGRES_PASSWORD: generate:password
  TIMESCALE_REPLICATION_PASSWORD:
    env: EC2_REPLICATION_PASSWORD
    generate: password
  APP_BACKEND_DB_PASSWORD: generate:password
  APP_BACKEND_READ_DB_PASSWORD: generate:password
  APP_FRONTEND_DB_PASSWORD: generate:password
  APP_MANTICORE_DB_PASSWORD: generate:password
  OTEL_MONITOR_DB_PASSWORD: generate:password
  APP_MIGRATE_DB_PASSWORD: generate:password
  PGSQL_PASS: inherit:APP_MANTICORE_DB_PASSWORD

  # ---------------------------------------------------------------------------
  # ProxySQL
  # ---------------------------------------------------------------------------
  PROXYSQL_ADMIN_PASSWORD: generate:password
  PGSQL_USER_APP_BACKEND_PASSWORD: inherit:APP_BACKEND_DB_PASSWORD

  # ---------------------------------------------------------------------------
  # PgBouncer (EC2 credentials for TEMP PATCH; auth_user for both bouncers)
  # ---------------------------------------------------------------------------
  EC2_DB_USER: optional
  EC2_DB_PASSWORD: optional
  APP_PGBOUNCER_PASSWORD: generate:password

  # ---------------------------------------------------------------------------
  # TimescaleDB standby (EC2 replication)
  # ---------------------------------------------------------------------------
  EC2_REPLICATION_PASSWORD: optional

  # ---------------------------------------------------------------------------
  # Backend (Django)
  # ---------------------------------------------------------------------------
  DJANGO_SECRET_KEY: generate:django
  BACKEND_DB_PASSWORD: inherit:APP_BACKEND_DB_PASSWORD
  BACKEND_READ_DB_PASSWORD: inherit:APP_BACKEND_READ_DB_PASSWORD
  SENDGRID_API_KEY: optional
  EMAIL_HOST_USER: optional
  EMAIL_HOST_PASSWORD: optional
  PPGF_CLIENT_ID: optional
  PPGF_SECRET: optional
  PPGF_PAYEE_MERCHANT_ID: optional
  PPGF_TIP_PAYEE_MERCHANT_ID: optional
  GRAPHICMAILAPI_LOGIN: optional
  GRAPHICMAILAPI_PASSWORD: optional

  # ---------------------------------------------------------------------------
  # Admin (SSH key for EC2 rsync/migration)
  # ---------------------------------------------------------------------------
  EC2_USER_RSA_KEY: optional

  # ---------------------------------------------------------------------------
  # API (legacy PHP — MySQL password)
  # ---------------------------------------------------------------------------
  APP_API_MYSQL_PASSWORD: inherit:APP_DB_PASSWORD

  # ---------------------------------------------------------------------------
  # Frontend
  # ---------------------------------------------------------------------------
  FRONTEND_DB_PASSWORD: inherit:APP_FRONTEND_DB_PASSWORD

  # ---------------------------------------------------------------------------
  # Donation (Stripe + SendGrid)
  # ---------------------------------------------------------------------------
  APP_DONATE_STRIPE_SECRET_KEY: optional
  APP_DONATE_SENDGRID_API_KEY: optional

  # ---------------------------------------------------------------------------
  # Facebook Login
  # ---------------------------------------------------------------------------
  FB_APP_ID: optional
  FB_APP_SECRET: optional
  FB_GRAPH_VERSION:
    default: "v21.0"
  APP_ENCRYPT_KEY: generate:hex

  # ---------------------------------------------------------------------------
  # Directus CMS
  # ---------------------------------------------------------------------------
  DIRECTUS_SECRET: generate:hex
  DIRECTUS_DB_PASSWORD: generate:password
  DIRECTUS_ADMIN_EMAIL:
    env: K8_ADMIN_EMAIL
    default: "admin@example.com"
  DIRECTUS_ADMIN_PASSWORD: generate:password
  DIRECTUS_REDIS_PASSWORD: generate:password
  DIRECTUS_TSDB_PASSWORD: inherit:DIRECTUS_DB_PASSWORD
  DIRECTUS_REDIS_USER:
    default: "directus"

  # ---------------------------------------------------------------------------
  # PostHog
  # ---------------------------------------------------------------------------
  POSTHOG_SECRET_KEY: generate:hex
  POSTHOG_DB_PASSWORD: generate:password
  POSTHOG_REDIS_PASSWORD: generate:password

  # ---------------------------------------------------------------------------
  # Infra Valkey (per-ACL-user, infra namespace)
  # ---------------------------------------------------------------------------
  DEFAULT_INFRA_REDIS_PASSWORD: generate:password
  INFISICAL_REDIS_PASSWORD: generate:password

# =============================================================================
# Mappings: Infisical folder → { secret_key: variable_name }
#
# Prefix variable name with ? to skip if the resolved value is empty.
# Without ?, the secret is always written (even with an empty string).
# =============================================================================

mappings:
  /mysqldb:
    MYSQL_ROOT_PASSWORD: MYSQL_ROOT_PASSWORD
    APP_DB_PASSWORD: APP_DB_PASSWORD
    APP_WORDPRESS_DB_PASSWORD: APP_WORDPRESS_DB_PASSWORD
    CMS_PAGES_APP_DB_PASSWORD: CMS_PAGES_APP_DB_PASSWORD
    LEGACY_APP_DB_PASSWORD: LEGACY_APP_DB_PASSWORD
    REPORTING_DB_PASSWORD: REPORTING_DB_PASSWORD
    OTEL_MONITOR_MYSQL_PASSWORD: OTEL_MONITOR_MYSQL_PASSWORD

  /wordpress:
    DB_PASSWORD: APP_WORDPRESS_DB_PASSWORD
    AUTH_KEY: WP_AUTH_KEY
    SECURE_AUTH_KEY: WP_SECURE_AUTH_KEY
    LOGGED_IN_KEY: WP_LOGGED_IN_KEY
    NONCE_KEY: WP_NONCE_KEY
    AUTH_SALT: WP_AUTH_SALT
    SECURE_AUTH_SALT: WP_SECURE_AUTH_SALT
    LOGGED_IN_SALT: WP_LOGGED_IN_SALT
    NONCE_SALT: WP_NONCE_SALT
    EC2_WP_DB_PASSWORD: "?EC2_WP_DB_PASSWORD"
    EC2_AUTH_KEY: "?EC2_WP_AUTH_KEY"
    EC2_SECURE_AUTH_KEY: "?EC2_WP_SECURE_AUTH_KEY"
    EC2_LOGGED_IN_KEY: "?EC2_WP_LOGGED_IN_KEY"
    EC2_NONCE_KEY: "?EC2_WP_NONCE_KEY"
    EC2_AUTH_SALT: "?EC2_WP_AUTH_SALT"
    EC2_SECURE_AUTH_SALT: "?EC2_WP_SECURE_AUTH_SALT"
    EC2_LOGGED_IN_SALT: "?EC2_WP_LOGGED_IN_SALT"
    EC2_NONCE_SALT: "?EC2_WP_NONCE_SALT"

  /wordpress-cms:
    DB_PASSWORD: CMS_DB_PASSWORD
    AUTH_KEY: CMS_AUTH_KEY
    SECURE_AUTH_KEY: CMS_SECURE_AUTH_KEY
    LOGGED_IN_KEY: CMS_LOGGED_IN_KEY
    NONCE_KEY: CMS_NONCE_KEY
    AUTH_SALT: CMS_AUTH_SALT
    SECURE_AUTH_SALT: CMS_SECURE_AUTH_SALT
    LOGGED_IN_SALT: CMS_LOGGED_IN_SALT
    NONCE_SALT: CMS_NONCE_SALT

  /manticore:
    PGSQL_HOST: PGSQL_HOST
    PGSQL_PORT: PGSQL_PORT
    PGSQL_USER: PGSQL_USER
    PGSQL_DB: PGSQL_DB
    PGSQL_PASS: PGSQL_PASS

  /redis:
    DEFAULT_APP_REDIS_PASSWORD: DEFAULT_APP_REDIS_PASSWORD
    APP_BACKEND_PASSWORD: APP_BACKEND_REDIS_PASSWORD
    APP_FRONTEND_PASSWORD: APP_FRONTEND_REDIS_PASSWORD
    APP_WORDPRESS_PASSWORD: APP_WORDPRESS_REDIS_PASSWORD
    WORDPRESS_CMS_PASSWORD: WORDPRESS_CMS_REDIS_PASSWORD
    OTEL_MONITOR_REDIS_PASSWORD: OTEL_MONITOR_REDIS_PASSWORD

  /valkey:
    DEFAULT_APP_REDIS_PASSWORD: DEFAULT_APP_REDIS_PASSWORD
    APP_BACKEND_PASSWORD: APP_BACKEND_REDIS_PASSWORD
    APP_FRONTEND_PASSWORD: APP_FRONTEND_REDIS_PASSWORD

  /timescaledb:
    POSTGRES_PASSWORD: TIMESCALE_POSTGRES_PASSWORD
    REPLICATION_PASSWORD: TIMESCALE_REPLICATION_PASSWORD
    APP_BACKEND_DB_PASSWORD: APP_BACKEND_DB_PASSWORD
    APP_BACKEND_READ_DB_PASSWORD: APP_BACKEND_READ_DB_PASSWORD
    APP_FRONTEND_DB_PASSWORD: APP_FRONTEND_DB_PASSWORD
    APP_MANTICORE_DB_PASSWORD: APP_MANTICORE_DB_PASSWORD
    REPORTING_DB_PASSWORD: REPORTING_DB_PASSWORD
    OTEL_MONITOR_DB_PASSWORD: OTEL_MONITOR_DB_PASSWORD
    APP_MIGRATE_DB_PASSWORD: APP_MIGRATE_DB_PASSWORD
    DIRECTUS_DB_PASSWORD: DIRECTUS_TSDB_PASSWORD
    EC2_REPLICATION_PASSWORD: "?EC2_REPLICATION_PASSWORD"

  /pgbouncer:
    EC2_DB_USER: "?EC2_DB_USER"
    EC2_DB_PASSWORD: "?EC2_DB_PASSWORD"
    APP_PGBOUNCER_PASSWORD: APP_PGBOUNCER_PASSWORD

  /proxysql:
    PROXYSQL_ADMIN_PASSWORD: PROXYSQL_ADMIN_PASSWORD
    PGSQL_USER_APP_BACKEND_PASSWORD: PGSQL_USER_APP_BACKEND_PASSWORD

  /backend:
    DJANGO_SECRET_KEY: DJANGO_SECRET_KEY
    DB_PASSWORD: BACKEND_DB_PASSWORD
    DB_REPLICA_PASSWORD: BACKEND_READ_DB_PASSWORD
    SENDGRID_API_KEY: "?SENDGRID_API_KEY"
    EMAIL_HOST_USER: "?EMAIL_HOST_USER"
    EMAIL_HOST_PASSWORD: "?EMAIL_HOST_PASSWORD"
    PPGF_CLIENT_ID: "?PPGF_CLIENT_ID"
    PPGF_SECRET: "?PPGF_SECRET"
    PPGF_PAYEE_MERCHANT_ID: "?PPGF_PAYEE_MERCHANT_ID"
    PPGF_TIP_PAYEE_MERCHANT_ID: "?PPGF_TIP_PAYEE_MERCHANT_ID"
    GRAPHICMAILAPI_LOGIN: "?GRAPHICMAILAPI_LOGIN"
    GRAPHICMAILAPI_PASSWORD: "?GRAPHICMAILAPI_PASSWORD"

  /admin:
    EC2_USER_RSA_KEY: "?EC2_USER_RSA_KEY"

  /api:
    MYSQL_PASSWORD: APP_API_MYSQL_PASSWORD

  /frontend:
    DB_PASSWORD: FRONTEND_DB_PASSWORD

  /donation:
    APP_DONATE_STRIPE_SECRET_KEY: APP_DONATE_STRIPE_SECRET_KEY
    APP_DONATE_SENDGRID_API_KEY: APP_DONATE_SENDGRID_API_KEY

  /fblogin:
    FB_APP_ID: "?FB_APP_ID"
    FB_APP_SECRET: "?FB_APP_SECRET"
    FB_GRAPH_VERSION: FB_GRAPH_VERSION
    APP_ENCRYPT_KEY: APP_ENCRYPT_KEY

  /infra-directus:
    DIRECTUS_SECRET: DIRECTUS_SECRET
    DB_PASSWORD: DIRECTUS_DB_PASSWORD
    ADMIN_EMAIL: DIRECTUS_ADMIN_EMAIL
    ADMIN_PASSWORD: DIRECTUS_ADMIN_PASSWORD
    DIRECTUS_REDIS_PASSWORD: DIRECTUS_REDIS_PASSWORD
    DIRECTUS_REDIS_USER: DIRECTUS_REDIS_USER

  /infra-posthog:
    POSTHOG_SECRET_KEY: POSTHOG_SECRET_KEY
    DB_PASSWORD: POSTHOG_DB_PASSWORD
    POSTHOG_REDIS_PASSWORD: POSTHOG_REDIS_PASSWORD

  /infra-valkey:
    DEFAULT_INFRA_REDIS_PASSWORD: DEFAULT_INFRA_REDIS_PASSWORD
    INFISICAL_PASSWORD: INFISICAL_REDIS_PASSWORD
    DIRECTUS_PASSWORD: DIRECTUS_REDIS_PASSWORD
    POSTHOG_PASSWORD: POSTHOG_REDIS_PASSWORD
